--- /dev/null
+++ b/sdl/libretro/emucap_debug.c
@@ -0,0 +1,329 @@
+#include "emucap_debug.h"
+
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <compiler.h>
+#include <cpucore.h>
+#include <fdd/diskdrv.h>
+#include <fdd/sxsi.h>
+#include <ia32/cpu.h>
+#include <i386c/cpumem.h>
+#include <np2.h>
+
+#define EMUCAP_MAX_BREAKPOINTS 64
+#define EMUCAP_EVENT_CAPACITY 256
+#define EMUCAP_TRACE_CAPACITY 4096
+#define EMUCAP_MEMORY_LIMIT 0x100000U
+
+struct breakpoint_slot {
+  int used;
+  uint64_t last_instruction;
+  int skip_exec_once;
+  struct emucap_np2_breakpoint value;
+};
+
+static struct breakpoint_slot breakpoints[EMUCAP_MAX_BREAKPOINTS];
+static struct emucap_np2_event events[EMUCAP_EVENT_CAPACITY];
+static struct emucap_np2_trace traces[EMUCAP_TRACE_CAPACITY];
+static size_t event_head, event_count, trace_head, trace_count;
+static uint64_t event_sequence, trace_sequence, instruction_sequence;
+static uint64_t dropped_events, dropped_trace;
+static int trace_enabled, stop_requested, suppress_memory, suppress_exec_once;
+
+static void capture_regs(struct emucap_np2_regs *out) {
+  memset(out, 0, sizeof(*out));
+  out->eax = CPU_EAX; out->ecx = CPU_ECX; out->edx = CPU_EDX; out->ebx = CPU_EBX;
+  out->esp = CPU_ESP; out->ebp = CPU_EBP; out->esi = CPU_ESI; out->edi = CPU_EDI;
+  out->eip = CPU_EIP; out->eflags = CPU_EFLAG;
+  out->cs = CPU_CS; out->ss = CPU_SS; out->ds = CPU_DS; out->es = CPU_ES;
+  out->fs = CPU_FS; out->gs = CPU_GS; out->cs_base = CPU_STAT_CS_BASE;
+  out->cr0 = CPU_CR0;
+}
+
+static uint32_t register_value(uint32_t index) {
+  switch (index) {
+  case 0: return CPU_EAX; case 1: return CPU_ECX; case 2: return CPU_EDX;
+  case 3: return CPU_EBX; case 4: return CPU_ESP; case 5: return CPU_EBP;
+  case 6: return CPU_ESI; case 7: return CPU_EDI; case 8: return CPU_EIP;
+  case 9: return CPU_EFLAG; case 10: return CPU_CS; case 11: return CPU_SS;
+  case 12: return CPU_DS; case 13: return CPU_ES; case 14: return CPU_FS;
+  case 15: return CPU_GS; default: return 0;
+  }
+}
+
+static int pc_matches(const struct emucap_np2_breakpoint *bp, uint32_t pc) {
+  return (!bp->has_pc_min || pc >= bp->pc_min) &&
+         (!bp->has_pc_max || pc <= bp->pc_max);
+}
+
+static void push_event(const struct emucap_np2_breakpoint *bp, uint32_t address,
+                       uint32_t size, uint32_t value) {
+  struct emucap_np2_event event;
+  size_t slot;
+  memset(&event, 0, sizeof(event));
+  event.sequence = ++event_sequence;
+  event.breakpoint_id = bp->id;
+  event.kind = bp->kind;
+  event.address = address;
+  event.size = size;
+  event.value = value;
+  event.paused = bp->pause_on_hit ? 1U : 0U;
+  capture_regs(&event.regs);
+  if (event_count == EMUCAP_EVENT_CAPACITY) {
+    event_head = (event_head + 1) % EMUCAP_EVENT_CAPACITY;
+    event_count--;
+    dropped_events++;
+  }
+  slot = (event_head + event_count) % EMUCAP_EVENT_CAPACITY;
+  events[slot] = event;
+  event_count++;
+  if (bp->pause_on_hit)
+    stop_requested = 1;
+}
+
+static void push_trace(void) {
+  struct emucap_np2_trace trace;
+  uint32_t next;
+  size_t bytes = 0;
+  size_t slot;
+  memset(&trace, 0, sizeof(trace));
+  trace.sequence = ++trace_sequence;
+  capture_regs(&trace.regs);
+  next = trace.regs.cs_base + trace.regs.eip;
+  emucap_np2_disassemble(next, trace.text, sizeof(trace.text), &next, NULL, &bytes);
+  if (trace_count == EMUCAP_TRACE_CAPACITY) {
+    trace_head = (trace_head + 1) % EMUCAP_TRACE_CAPACITY;
+    trace_count--;
+    dropped_trace++;
+  }
+  slot = (trace_head + trace_count) % EMUCAP_TRACE_CAPACITY;
+  traces[slot] = trace;
+  trace_count++;
+}
+
+uint32_t emucap_np2_debug_api_version(void) {
+  return EMUCAP_NP2_DEBUG_API_VERSION;
+}
+
+int emucap_np2_read_memory(uint32_t address, uint8_t *output, size_t length) {
+  size_t index;
+  if (!output || length == 0 || address >= EMUCAP_MEMORY_LIMIT ||
+      length > EMUCAP_MEMORY_LIMIT - address)
+    return 0;
+  suppress_memory++;
+  for (index = 0; index < length; index++)
+    output[index] = memp_read8(address + (uint32_t)index);
+  suppress_memory--;
+  return 1;
+}
+
+int emucap_np2_write_memory(uint32_t address, const uint8_t *input, size_t length) {
+  size_t index;
+  if (!input || length == 0 || address >= EMUCAP_MEMORY_LIMIT ||
+      length > EMUCAP_MEMORY_LIMIT - address)
+    return 0;
+  suppress_memory++;
+  for (index = 0; index < length; index++)
+    memp_write8(address + (uint32_t)index, input[index]);
+  suppress_memory--;
+  return 1;
+}
+
+int emucap_np2_get_regs(struct emucap_np2_regs *output) {
+  if (!output) return 0;
+  capture_regs(output);
+  return 1;
+}
+
+int emucap_np2_step_instruction(void) {
+  int jump;
+  SINT32 saved_clock = CPU_REMCLOCK;
+  if (emucap_debug_instruction())
+    return EMUCAP_NP2_STEP_PREEMPTED;
+  suppress_exec_once = 1;
+  jump = sigsetjmp(exec_1step_jmpbuf, 1);
+  if (jump == 0) {
+    CPU_REMCLOCK = INT_MAX / 4;
+    exec_1step();
+  }
+  CPU_REMCLOCK = saved_clock;
+  suppress_exec_once = 0;
+  return jump == 0 ? EMUCAP_NP2_STEP_EXECUTED : EMUCAP_NP2_STEP_FAILED;
+}
+
+int emucap_np2_disassemble(uint32_t address, char *text, size_t text_size,
+                           uint32_t *next_address, uint8_t *bytes,
+                           size_t *byte_count) {
+  disasm_context_t context;
+  uint32_t offset;
+  size_t count;
+  if (!text || text_size == 0 || !next_address || !byte_count ||
+      address < CPU_STAT_CS_BASE)
+    return 0;
+  offset = address - CPU_STAT_CS_BASE;
+  suppress_memory++;
+  if (disasm(&offset, &context) != 0) {
+    suppress_memory--;
+    return 0;
+  }
+  suppress_memory--;
+  snprintf(text, text_size, "%s", context.str);
+  *next_address = CPU_STAT_CS_BASE + offset;
+  count = context.nopbytes < 0 ? 0U : (size_t)context.nopbytes;
+  if (count > sizeof(context.opbyte)) count = sizeof(context.opbyte);
+  if (bytes && *byte_count >= count) memcpy(bytes, context.opbyte, count);
+  *byte_count = count;
+  return 1;
+}
+
+int emucap_np2_set_breakpoint(const struct emucap_np2_breakpoint *breakpoint) {
+  size_t index;
+  if (!breakpoint || breakpoint->id == 0 || breakpoint->kind > EMUCAP_NP2_BP_RESET)
+    return 0;
+  for (index = 0; index < EMUCAP_MAX_BREAKPOINTS; index++) {
+    if (breakpoints[index].used && breakpoints[index].value.id == breakpoint->id)
+      return 0;
+  }
+  for (index = 0; index < EMUCAP_MAX_BREAKPOINTS; index++) {
+    if (!breakpoints[index].used) {
+      breakpoints[index].used = 1;
+      breakpoints[index].last_instruction = 0;
+      breakpoints[index].value = *breakpoint;
+      return 1;
+    }
+  }
+  return 0;
+}
+
+int emucap_np2_clear_breakpoint(uint64_t id) {
+  size_t index;
+  for (index = 0; index < EMUCAP_MAX_BREAKPOINTS; index++) {
+    if (breakpoints[index].used && breakpoints[index].value.id == id) {
+      memset(&breakpoints[index], 0, sizeof(breakpoints[index]));
+      return 1;
+    }
+  }
+  return 0;
+}
+
+void emucap_np2_clear_all_breakpoints(void) {
+  memset(breakpoints, 0, sizeof(breakpoints));
+}
+
+int emucap_np2_poll_event(struct emucap_np2_event *event) {
+  if (!event || event_count == 0) return 0;
+  *event = events[event_head];
+  event_head = (event_head + 1) % EMUCAP_EVENT_CAPACITY;
+  event_count--;
+  return 1;
+}
+
+uint64_t emucap_np2_take_dropped_events(void) {
+  uint64_t result = dropped_events;
+  dropped_events = 0;
+  return result;
+}
+
+void emucap_np2_set_trace(int enabled) {
+  trace_enabled = enabled != 0;
+  if (!trace_enabled) {
+    trace_head = 0;
+    trace_count = 0;
+    dropped_trace = 0;
+  }
+}
+
+int emucap_np2_poll_trace(struct emucap_np2_trace *trace) {
+  if (!trace || trace_count == 0) return 0;
+  *trace = traces[trace_head];
+  trace_head = (trace_head + 1) % EMUCAP_TRACE_CAPACITY;
+  trace_count--;
+  return 1;
+}
+
+uint64_t emucap_np2_take_dropped_trace(void) {
+  uint64_t result = dropped_trace;
+  dropped_trace = 0;
+  return result;
+}
+
+int emucap_np2_stop_requested(void) { return stop_requested; }
+void emucap_np2_clear_stop(void) { stop_requested = 0; }
+
+void emucap_np2_reset_event(void) {
+  size_t index;
+  instruction_sequence++;
+  for (index = 0; index < EMUCAP_MAX_BREAKPOINTS; index++) {
+    struct emucap_np2_breakpoint *bp = &breakpoints[index].value;
+    breakpoints[index].skip_exec_once = 0;
+    if (breakpoints[index].used && bp->kind == EMUCAP_NP2_BP_RESET)
+      push_event(bp, 0, 0, 0);
+  }
+}
+
+int emucap_debug_instruction(void) {
+  size_t index;
+  uint32_t pc = CPU_STAT_CS_BASE + CPU_EIP;
+  if (suppress_exec_once) return 0;
+  instruction_sequence++;
+  if (trace_enabled) push_trace();
+  for (index = 0; index < EMUCAP_MAX_BREAKPOINTS; index++) {
+    struct breakpoint_slot *slot = &breakpoints[index];
+    struct emucap_np2_breakpoint *bp = &slot->value;
+    uint32_t value;
+    if (!slot->used || !pc_matches(bp, pc)) continue;
+    if (bp->kind == EMUCAP_NP2_BP_EXEC && pc >= bp->start && pc <= bp->end) {
+      if (slot->skip_exec_once) {
+        slot->skip_exec_once = 0;
+        continue;
+      }
+      slot->last_instruction = instruction_sequence;
+      if (bp->pause_on_hit) slot->skip_exec_once = 1;
+      push_event(bp, pc, 1, 0);
+    } else if (bp->kind == EMUCAP_NP2_BP_REGISTER) {
+      value = register_value(bp->register_index);
+      if (value < bp->register_min || value > bp->register_max) {
+        slot->last_instruction = instruction_sequence;
+        push_event(bp, pc, 0, value);
+      }
+    }
+  }
+  return stop_requested;
+}
+
+void emucap_debug_memory(uint32_t address, uint32_t size, uint32_t value, int write) {
+  size_t index;
+  uint32_t end;
+  uint32_t pc = CPU_STAT_CS_BASE + CPU_EIP;
+  if (suppress_memory || size == 0) return;
+  end = address + size - 1;
+  if (end < address) end = UINT32_MAX;
+  for (index = 0; index < EMUCAP_MAX_BREAKPOINTS; index++) {
+    struct breakpoint_slot *slot = &breakpoints[index];
+    struct emucap_np2_breakpoint *bp = &slot->value;
+    int kind_match;
+    if (!slot->used || slot->last_instruction == instruction_sequence ||
+        !pc_matches(bp, pc)) continue;
+    kind_match = bp->kind == EMUCAP_NP2_BP_ACCESS ||
+                 (write && bp->kind == EMUCAP_NP2_BP_WRITE) ||
+                 (!write && bp->kind == EMUCAP_NP2_BP_READ);
+    if (!kind_match || end < bp->start || address > bp->end) continue;
+    if (bp->has_value &&
+        (size != bp->value_len ||
+         (value & bp->value_mask) != (bp->value & bp->value_mask)))
+      continue;
+    slot->last_instruction = instruction_sequence;
+    push_event(bp, address, size, value);
+  }
+}
+
+int emucap_np2_change_hdd(const char *path) {
+  if (!path || !path[0] || strlen(path) >= MAX_PATH) return 0;
+  diskdrv_setsxsi(0, path);
+  diskdrv_hddbind();
+  return strcmp(diskdrv_getsxsi(0), path) == 0;
+}
+
+const char *emucap_np2_current_hdd(void) { return diskdrv_getsxsi(0); }
