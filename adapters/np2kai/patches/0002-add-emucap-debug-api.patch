+#ifndef NP2KAI_EMUCAP_DEBUG_H
+#define NP2KAI_EMUCAP_DEBUG_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define EMUCAP_NP2_DEBUG_API_VERSION 1
+#define EMUCAP_NP2_BP_EXEC 0
+#define EMUCAP_NP2_BP_READ 1
+#define EMUCAP_NP2_BP_WRITE 2
+#define EMUCAP_NP2_BP_ACCESS 3
+#define EMUCAP_NP2_BP_REGISTER 4
+#define EMUCAP_NP2_BP_RESET 5
+#define EMUCAP_NP2_STEP_FAILED 0
+#define EMUCAP_NP2_STEP_EXECUTED 1
+#define EMUCAP_NP2_STEP_PREEMPTED 2
+
+struct emucap_np2_regs {
+  uint32_t eax, ecx, edx, ebx, esp, ebp, esi, edi;
+  uint32_t eip, eflags;
+  uint16_t cs, ss, ds, es, fs, gs;
+  uint32_t cs_base;
+  uint32_t cr0;
+};
+
+struct emucap_np2_breakpoint {
+  uint64_t id;
+  uint32_t kind;
+  uint32_t start;
+  uint32_t end;
+  uint32_t pause_on_hit;
+  uint32_t has_pc_min;
+  uint32_t pc_min;
+  uint32_t has_pc_max;
+  uint32_t pc_max;
+  uint32_t has_value;
+  uint32_t value;
+  uint32_t value_mask;
+  uint32_t value_len;
+  uint32_t register_index;
+  uint32_t register_min;
+  uint32_t register_max;
+};
+
+struct emucap_np2_event {
+  uint64_t sequence;
+  uint64_t breakpoint_id;
+  uint32_t kind;
+  uint32_t address;
+  uint32_t size;
+  uint32_t value;
+  uint32_t paused;
+  struct emucap_np2_regs regs;
+};
+
+struct emucap_np2_trace {
+  uint64_t sequence;
+  struct emucap_np2_regs regs;
+  char text[256];
+};
+
+uint32_t emucap_np2_debug_api_version(void);
+int emucap_np2_read_memory(uint32_t address, uint8_t *output, size_t length);
+int emucap_np2_write_memory(uint32_t address, const uint8_t *input, size_t length);
+int emucap_np2_get_regs(struct emucap_np2_regs *output);
+int emucap_np2_step_instruction(void);
+int emucap_np2_disassemble(uint32_t address, char *text, size_t text_size,
+                           uint32_t *next_address, uint8_t *bytes,
+                           size_t *byte_count);
+int emucap_np2_set_breakpoint(const struct emucap_np2_breakpoint *breakpoint);
+int emucap_np2_clear_breakpoint(uint64_t id);
+void emucap_np2_clear_all_breakpoints(void);
+int emucap_np2_poll_event(struct emucap_np2_event *event);
+uint64_t emucap_np2_take_dropped_events(void);
+void emucap_np2_set_trace(int enabled);
+int emucap_np2_poll_trace(struct emucap_np2_trace *trace);
+uint64_t emucap_np2_take_dropped_trace(void);
+int emucap_np2_stop_requested(void);
+void emucap_np2_clear_stop(void);
+void emucap_np2_reset_event(void);
+int emucap_np2_change_hdd(const char *path);
+const char *emucap_np2_current_hdd(void);
+
+int emucap_debug_instruction(void);
+void emucap_debug_memory(uint32_t address, uint32_t size, uint32_t value,
