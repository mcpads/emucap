+static int emucap_peek_byte(uint32_t address, uint8_t *value) {
+  const UINT operate = vramop.operate;
+  const uint32_t page = (operate & (1U << VOPBIT_ACCESS)) ? VRAM_STEP : 0;
+  const int vga = (operate & (1U << VOPBIT_VGA)) != 0;
+  if (address < CPU_MEMREADMAX) {
+    *value = mem[address];
+    return 1;
+  }
+  if (!vga && address >= 0xA8000U && address < 0xC0000U) {
+    *value = mem[address + page];
+    return 1;
+  }
+  if (!vga && (operate & (1U << VOPBIT_ANALOG)) && address >= 0xE0000U &&
+      address < 0xE8000U) {
+    *value = mem[address + page];
+    return 1;
+  }
+  return 0;
+}
+
+int emucap_np2_peek_memory(uint32_t address, uint8_t *output, size_t length) {
+  size_t index;
+  if (!output || length == 0 || address >= EMUCAP_MEMORY_LIMIT ||
+      length > EMUCAP_MEMORY_LIMIT - address)
+    return 0;
+  for (index = 0; index < length; index++) {
+    if (!emucap_peek_byte(address + (uint32_t)index, &output[index]))
+      return 0;
+  }
+  return 1;
+}
