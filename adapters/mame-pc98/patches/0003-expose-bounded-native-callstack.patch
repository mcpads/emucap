+//-------------------------------------------------
+//  callstack_enable - enable the bounded native
+//  call stack tracker
+//-------------------------------------------------
+
+void device_debug::callstack_enable(bool enable)
+{
+	if (m_callstack_enabled != enable)
+	{
+		m_callstack_enabled = enable;
+		m_callstack_sp_entry = nullptr;
+		if (enable && m_state)
+		{
+			for (auto const &entry : m_state->state_entries())
+			{
+				if (!std::strcmp(entry->symbol(), "SP"))
+				{
+					m_callstack_sp_entry = entry.get();
+					break;
+				}
+			}
+		}
+		callstack_clear(false);
+	}
+}
+
+
+//-------------------------------------------------
+//  callstack_clear - discard observations that no
+//  longer belong to the current execution history
+//-------------------------------------------------
+
+void device_debug::callstack_clear(bool complete)
+{
+	m_callstack_frames.clear();
+	m_callstack_complete = complete;
+	m_callstack_have_previous = false;
+	m_callstack_previous_pc = 0;
+	m_callstack_previous_next = 0;
+	m_callstack_previous_flags = 0;
+	m_callstack_previous_sp = 0;
+	m_callstack_dropped = 0;
+}
+
+
+//-------------------------------------------------
+//  update_callstack - observe one completed control
+//  transfer and prepare the next one
+//-------------------------------------------------
+
+void device_debug::update_callstack(offs_t curpc)
+{
+	u64 const current_sp = m_callstack_sp_entry ? m_callstack_sp_entry->value() : 0;
+	if (m_callstack_have_previous)
+	{
+		if ((m_callstack_previous_flags & util::disasm_interface::STEP_OVER) != 0 &&
+				(m_callstack_previous_flags & util::disasm_interface::STEP_COND) == 0 &&
+				curpc != m_callstack_previous_next)
+		{
+			if (m_callstack_frames.size() == CALLSTACK_CAPACITY)
+			{
+				m_callstack_frames.erase(m_callstack_frames.begin());
+				++m_callstack_dropped;
+				m_callstack_complete = false;
+			}
+			m_callstack_frames.push_back(callstack_frame{
+				m_callstack_previous_pc,
+				curpc,
+				m_callstack_previous_next,
+				m_callstack_previous_sp });
+		}
+		else if ((m_callstack_previous_flags & util::disasm_interface::STEP_OUT) != 0)
+		{
+			auto match = std::find_if(
+				m_callstack_frames.rbegin(),
+				m_callstack_frames.rend(),
+				[curpc, current_sp] (callstack_frame const &frame)
+				{
+					return frame.return_address == curpc && frame.stack_pointer == current_sp;
+				});
+			if (match != m_callstack_frames.rend())
+				m_callstack_frames.erase(match.base() - 1, m_callstack_frames.end());
+		}
+	}
+
+	debug_disasm_buffer buffer(device());
+	u32 const result = buffer.disassemble_info(curpc);
+	if ((result & util::disasm_interface::SUPPORTED) == 0)
+	{
+		m_callstack_have_previous = false;
+		return;
+	}
+	m_callstack_previous_pc = curpc;
+	m_callstack_previous_next = buffer.next_pc_wrap(curpc, result & util::disasm_interface::LENGTHMASK);
+	m_callstack_previous_flags = result;
+	m_callstack_previous_sp = current_sp;
+	m_callstack_have_previous = true;
 }
 
 
