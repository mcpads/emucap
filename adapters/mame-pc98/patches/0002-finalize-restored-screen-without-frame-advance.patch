@@ -1568,6 +1568,65 @@ void screen_device::pixels(u32 *buffer)
 }
 
 
+//-------------------------------------------------
+//  presented_pixels - copy the last bitmap that was
+//  published to the render texture
+//-------------------------------------------------
+
+void screen_device::presented_pixels(u32 *buffer)
+{
+	screen_bitmap &bitmap = m_bitmap[m_curtexture];
+	if (!bitmap.valid() || bitmap.format() != BITMAP_FORMAT_RGB32)
+		return;
+
+	for (int y = m_visarea.min_y; y <= m_visarea.max_y; y++)
+	{
+		u32 const *source = &bitmap.as_rgb32().pix(y, m_visarea.min_x);
+		std::copy_n(source, m_visarea.width(), buffer);
+		buffer += m_visarea.width();
+	}
+}
+
+
+//-------------------------------------------------
+//  restore_presented_pixels - restore an observed
+//  raster image without advancing emulated time
+//-------------------------------------------------
+
+bool screen_device::restore_presented_pixels(void const *buffer, size_t bytes, u32 width, u32 height)
+{
+	if (m_type == SCREEN_TYPE_VECTOR || m_type == SCREEN_TYPE_SVG ||
+			(m_video_attributes & (VIDEO_SELF_RENDER | VIDEO_VARIABLE_WIDTH)) ||
+			width != u32(m_visarea.width()) || height != u32(m_visarea.height()) ||
+			bytes != (size_t(width) * size_t(height) * sizeof(u32)))
+		return false;
+
+	for (screen_bitmap &bitmap : m_bitmap)
+	{
+		if (!bitmap.valid() || bitmap.format() != BITMAP_FORMAT_RGB32)
+			return false;
+	}
+
+	u8 const *source = reinterpret_cast<u8 const *>(buffer);
+	for (screen_bitmap &bitmap : m_bitmap)
+	{
+		for (int y = m_visarea.min_y; y <= m_visarea.max_y; y++)
+		{
+			void *destination = &bitmap.as_rgb32().pix(y, m_visarea.min_x);
+			std::memcpy(destination, source, size_t(width) * sizeof(u32));
+			source += size_t(width) * sizeof(u32);
+		}
+		source = reinterpret_cast<u8 const *>(buffer);
+	}
+
+	// Publish through the ordinary texture/container path.  Both raster buffers contain
+	// the same saved image, so the normal buffer swap cannot expose an uninitialised frame.
+	m_changed = true;
+	update_quads();
+	return true;
+}
+
+
