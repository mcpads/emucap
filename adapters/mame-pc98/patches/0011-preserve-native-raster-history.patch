 //  after a save state is loaded
 //-------------------------------------------------
 
+bool screen_device::raster_state_geometry_valid() const
+{
+	return m_state_bitmap_width > 0 && m_state_bitmap_height > 0
+		&& m_state_bitmap_width <= m_state_max_width && m_state_bitmap_height <= m_state_max_height
+		&& m_width > 0 && m_height > 0
+		&& m_visarea.min_x >= 0 && m_visarea.min_y >= 0
+		&& m_visarea.min_x <= m_visarea.max_x && m_visarea.min_y <= m_visarea.max_y
+		&& m_visarea.max_x < m_state_bitmap_width && m_visarea.max_y < m_state_bitmap_height
+		&& std::max(m_width, m_visarea.max_x + 1) == m_state_bitmap_width
+		&& std::max(m_height, m_visarea.max_y + 1) == m_state_bitmap_height
+		&& m_curbitmap < 2 && m_curtexture < 2;
+}
+
+void screen_device::device_pre_save()
+{
+	if (m_state_bitmap[0].empty())
+		return;
+	m_state_bitmap_width = m_bitmap[0].width();
+	m_state_bitmap_height = m_bitmap[0].height();
+	if (!raster_state_geometry_valid())
+		throw emu_fatalerror("%s: invalid native raster-state geometry", tag());
+	for (unsigned i = 0; i != 2; ++i)
+	{
+		if (m_bitmap[i].format() != BITMAP_FORMAT_RGB32 ||
+				m_bitmap[i].width() != m_state_bitmap_width || m_bitmap[i].height() != m_state_bitmap_height)
+			throw emu_fatalerror("%s: inconsistent native raster buffers", tag());
+	}
+	if (m_priority.width() != m_state_bitmap_width || m_priority.height() != m_state_bitmap_height)
+		throw emu_fatalerror("%s: inconsistent native priority buffer", tag());
+	for (unsigned i = 0; i != 2; ++i)
+	{
+		std::fill(m_state_bitmap[i].begin(), m_state_bitmap[i].end(), 0);
+		for (s32 y = 0; y != m_state_bitmap_height; ++y)
+			std::copy_n(&m_bitmap[i].as_rgb32().pix(y), m_state_bitmap_width,
+				&m_state_bitmap[i][size_t(y) * m_state_max_width]);
+	}
+	std::fill(m_state_priority.begin(), m_state_priority.end(), 0);
+	for (s32 y = 0; y != m_state_bitmap_height; ++y)
+		std::copy_n(&m_priority.pix(y), m_state_bitmap_width, &m_state_priority[size_t(y) * m_state_max_width]);
+}
+
+void screen_device::publish_restored_raster()
+{
+	// Rebind the saved presented texture without an update, swap or changed-flag reset.
+	for (unsigned i = 0; i != 2; ++i)
+		m_texture[i]->set_bitmap(m_bitmap[i], m_visarea, m_bitmap[i].texformat());
+	rgb_t color = m_color - rgb_t(0, 0xff - m_brightness, 0xff - m_brightness, 0xff - m_brightness);
+	m_container->empty();
+	m_container->add_quad(0.0f, 0.0f, 1.0f, 1.0f, color, m_texture[m_curtexture], PRIMFLAG_BLENDMODE(BLENDMODE_NONE) | PRIMFLAG_SCREENTEX(1));
+}
+
 void screen_device::device_post_load()
 {
+	bool const saved_raster = !m_state_bitmap[0].empty();
+	if (saved_raster && !raster_state_geometry_valid())
+		throw emu_fatalerror("%s: invalid restored raster-state geometry", tag());
 	realloc_screen_bitmaps();
+	if (saved_raster)
+	{
+		for (unsigned i = 0; i != 2; ++i)
+			for (s32 y = 0; y != m_state_bitmap_height; ++y)
+				std::copy_n(&m_state_bitmap[i][size_t(y) * m_state_max_width], m_state_bitmap_width,
+					&m_bitmap[i].as_rgb32().pix(y));
+		for (s32 y = 0; y != m_state_bitmap_height; ++y)
+			std::copy_n(&m_state_priority[size_t(y) * m_state_max_width], m_state_bitmap_width, &m_priority.pix(y));
+		publish_restored_raster();
+	}
 }
 
 
