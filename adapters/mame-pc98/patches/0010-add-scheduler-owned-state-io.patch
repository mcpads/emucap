+
+bool running_machine::state_io_ready() const
+{
+	return m_current_phase == machine_phase::RUNNING && m_paused
+		&& state_io_boundary() && m_scheduler.can_save()
+		&& !m_state_file_io_active && m_saveload_schedule == saveload_schedule::NONE;
+}
+
+std::string running_machine::state_file_io(bool load, std::string const &filename)
+{
+	if (!state_io_ready())
+		return "unsafe_halt";
+	if (filename.empty())
+		return "invalid_path";
+	struct operation_scope
+	{
+		bool &active;
+		explicit operation_scope(bool &value) : active(value) { active = true; }
+		~operation_scope() { active = false; }
+	} scope(m_state_file_io_active);
+
+	emu_file file("", load ? OPEN_FLAG_READ : (OPEN_FLAG_WRITE | OPEN_FLAG_CREATE | OPEN_FLAG_CREATE_PATHS));
+	if (file.open(filename))
+		return "open_failed";
+	if (!load)
+	{
+		bool ok = false;
+		try { ok = m_save.write_file(file) == STATERR_NONE; }
+		catch (...) { }
+		if (!ok)
+			file.remove_on_close();
+		file.close();
+		return ok ? "completed" : "save_failed";
+	}
+
+	// Capture the native rollback image before the first load write. A failed
+	// restore is explicitly uncertain; the caller must not retain healthy control.
+	std::vector<u8> previous;
+	try
+	{
+		previous.resize(ram_state::get_size(m_save));
+		if (m_save.write_buffer(previous.data(), previous.size()) != STATERR_NONE)
+			return "rollback_capture_failed";
+	}
+	catch (...) { return "rollback_capture_failed"; }
+	bool loaded = false;
+	try { loaded = m_save.read_file(file) == STATERR_NONE; }
+	catch (...) { }
+	file.close();
+	if (loaded)
+		return "completed";
+	try
+	{
+		if (m_save.read_buffer(previous.data(), previous.size()) == STATERR_NONE)
+			return "load_failed_rolled_back";
+	}
+	catch (...) { }
+	return "load_failed_unverified";
+}
