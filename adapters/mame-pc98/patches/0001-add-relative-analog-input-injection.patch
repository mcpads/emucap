+//-------------------------------------------------
+//  add_relative_value - queue programmatic motion
+//  for the next relative input sample
+//-------------------------------------------------
+
+void analog_field::add_relative_value(s32 delta)
+{
+	// Relative OSD inputs use RELATIVE_PER_PIXEL raw units.  Queue the converted delta rather
+	// than changing m_accum immediately: PORT_RESET axes clear m_accum at the next frame before
+	// they apply device motion.  The pending value is consumed beside that native frame delta.
+	s64 const raw_delta = (s64(delta) * osd::input_device::RELATIVE_PER_PIXEL * 100) / m_sensitivity;
+	s64 const pending = std::clamp<s64>(s64(m_pending_relative) + raw_delta, std::numeric_limits<s32>::min(), std::numeric_limits<s32>::max());
+	m_pending_relative = s32(pending);
+}
+
+
 //-------------------------------------------------
 //  clear_value - clear programmatic override
 //-------------------------------------------------
@@ -3982,6 +4012,9 @@ void analog_field::frame_update(running_machine &machine)
 	if (m_field.analog_reset())
 		m_accum = 0;
 
+	delta = s32(std::clamp<s64>(s64(delta) + m_pending_relative, std::numeric_limits<s32>::min(), std::numeric_limits<s32>::max()));
+	m_pending_relative = 0;
+
 	// apply the delta to the accumulated value
 	m_accum += delta;
 
