+	video_type.set_function("set_throttle_wait_hook",
+			[this] (video_manager &vm, sol::object callback)
+			{
+				if (callback == sol::lua_nil)
+				{
+					vm.set_throttle_wait_hook(nullptr);
+					return;
+				}
+				// Bind to the main Lua thread: a plugin may register from a notifier coroutine whose
+				// thread is collected before the hook runs.
+				vm.set_throttle_wait_hook(
+						[this, hook = callback.as<sol::main_protected_function>()] () -> bool
+						{
+							auto result = invoke_direct(hook);
+							if (!result.valid())
+							{
+								sol::error err = result;
+								osd_printf_error("[LUA ERROR] in throttle wait hook: %s\n", err.what());
+								return false;
+							}
+							return (result.get_type() == sol::type::boolean) && result.get<bool>();
+						});
+			});
