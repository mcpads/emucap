+// Agent pacing. The CLI frame loop waits in emucap_pace_frames() after each emulated frame. The
+// target is a percent of the DS refresh (560190 cycles at 33513982 Hz); 0 is unlimited. The stub
+// thread changes it and reads it back while the guest runs, and a break request or a policy
+// change ends the current wait so control does not queue behind a slow frame.
+static std::atomic<uint32_t> emucap_pace_percent{100};
+static std::atomic<bool> emucap_native_unlimited{false};
+static std::atomic<uint64_t> emucap_pace_revision{1};
+static std::atomic<bool> emucap_pace_wake{false};
+static std::atomic<uint64_t> emucap_vblank_clock{0};
+
+void emucap_pace_frames(int frames, int native_unlimited) {
+  typedef std::chrono::steady_clock clock;
+  static clock::time_point deadline;
+  static bool anchored = false;
+  const bool native = native_unlimited != 0;
+  if (emucap_native_unlimited.exchange(native) != native)
+    emucap_pace_revision.fetch_add(1);
+  const uint32_t percent = emucap_pace_percent.load();
+  if (native || percent == 0 || emucap_pace_wake.exchange(false)) {
+    anchored = false;
+    return;
+  }
+  const clock::time_point now = clock::now();
+  // A host that falls this far behind (a stop or a slow host) re-anchors instead of catching up.
+  if (!anchored || now - deadline > std::chrono::milliseconds(100)) {
+    deadline = now;
+    anchored = true;
+  }
+  deadline += std::chrono::nanoseconds(
+      (int64_t)frames * 560190LL * 1000000000LL / 33513982LL * 100 / percent);
+  for (;;) {
+    const clock::duration remaining = deadline - clock::now();
+    if (remaining <= clock::duration::zero())
+      return;
+    std::this_thread::sleep_for(std::min<clock::duration>(remaining, std::chrono::milliseconds(10)));
+    if (emucap_pace_wake.exchange(false)) {
+      anchored = false;
+      return;
+    }
+  }
+}
+
+// Requests the stub answers while the guest runs: they read or set pacing and override counters
+// only, so they neither touch guest state nor need a stopped CPU.
+static bool emucap_running_safe_packet(const uint8_t *packet) {
+  static const char *const prefixes[] = {
+    "qEmucap,pacing", "QEmucap,pacing:", "qEmucap,inputstatus", "qEmucap,touchstatus",
+  };
+  for (size_t i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++) {
+    if (strncmp((const char *)packet, prefixes[i], strlen(prefixes[i])) == 0)
+      return true;
+  }
+  return false;
+}
