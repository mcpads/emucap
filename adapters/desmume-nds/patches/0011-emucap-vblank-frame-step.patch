+void emucap_gdbstub_vblank_start_complete() {
+  emucap_frame_step.clock++;
+  if (emucap_frame_step.terminal != EMUCAP_FRAME_STEP_RUNNING)
+    return;
+
+  emucap_frame_step.completed++;
+  if (emucap_frame_step.completed < emucap_frame_step.requested)
+    return;
+
+  struct gdb_stub_state *owner = emucap_frame_step.owner;
+  emucap_frame_step.terminal = EMUCAP_FRAME_STEP_COMPLETED;
+  emucap_frame_step.end = emucap_frame_step.clock;
+  if (owner == NULL)
+    return;
+
+  NDS_debug_break();
+  owner->cpu_ctrl->remove_post_ex_fn(owner->cpu_ctrl->data);
+  emucap_stop_sibling_gdb_stubs(owner);
+  owner->stop_type = STOP_STEP_BREAK;
+  owner->stop_address = 0;
+  indicateCPUStop_gdb(owner);
+}
+
+static bool emucap_begin_frame_step(struct gdb_stub_state *owner, uint32_t count) {
+  if (owner == NULL || count == 0 || emucap_frame_step.terminal == EMUCAP_FRAME_STEP_RUNNING)
+    return false;
+  if (emucap_gdb_stubs[0] == NULL || emucap_gdb_stubs[1] == NULL)
+    return false;
+
+  emucap_frame_step.terminal = EMUCAP_FRAME_STEP_RUNNING;
+  emucap_frame_step.owner = owner;
+  emucap_frame_step.start = emucap_frame_step.clock;
+  emucap_frame_step.end = emucap_frame_step.clock;
+  emucap_frame_step.requested = count;
+  emucap_frame_step.completed = 0;
+  return true;
+}
+
+static uint32_t emucap_format_frame_step_status(char *out, size_t capacity) {
+  const char *terminal = "idle";
+  switch (emucap_frame_step.terminal) {
+    case EMUCAP_FRAME_STEP_RUNNING: terminal = "running"; break;
+    case EMUCAP_FRAME_STEP_COMPLETED: terminal = "completed"; break;
+    case EMUCAP_FRAME_STEP_INTERRUPTED: terminal = "interrupted"; break;
+    case EMUCAP_FRAME_STEP_IDLE: break;
+  }
+  return (uint32_t)snprintf(
+      out, capacity, "%s:%llx,%llx,%x,%x", terminal,
+      (unsigned long long)emucap_frame_step.start,
+      (unsigned long long)emucap_frame_step.end,
+      (unsigned)emucap_frame_step.requested,
+      (unsigned)emucap_frame_step.completed);
+}
