+#pragma once
+#include <cstdint>
+#include <mutex>
+
+struct EmucapPacingSnapshot {
+    uint32_t percent = 100;
+    bool nativeUnlimited = false;
+    uint64_t revision = 1;
+};
+struct EmucapPacingChange {
+    bool accepted;
+    EmucapPacingSnapshot previous;
+    EmucapPacingSnapshot applied;
+};
+class EmucapPacingOwner {
+public:
+    EmucapPacingSnapshot Read() const {
+        std::lock_guard<std::mutex> guard(mutex_);
+        return policy_;
+    }
+    // Publish source edges, not repeated samples of a cleared native override.
+    EmucapPacingSnapshot ObserveNative(bool unlimited) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        if (!initialized_ || unlimited != sourceUnlimited_) {
+            initialized_ = true;
+            sourceUnlimited_ = unlimited;
+            if (policy_.nativeUnlimited != unlimited) {
+                policy_.nativeUnlimited = unlimited;
+                ++policy_.revision;
+            }
+        }
+        return policy_;
+    }
+    EmucapPacingChange Apply(uint32_t percent) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        const auto previous = policy_;
+        if (percent > 10000)
+            return {false, previous, previous};
+        if (policy_.percent != percent || policy_.nativeUnlimited) {
+            policy_.percent = percent;
+            policy_.nativeUnlimited = false;
+            ++policy_.revision;
+        }
+        return {true, previous, policy_};
+    }
+private:
+    mutable std::mutex mutex_;
+    EmucapPacingSnapshot policy_;
+    bool initialized_ = false;
+    bool sourceUnlimited_ = false;
+};
