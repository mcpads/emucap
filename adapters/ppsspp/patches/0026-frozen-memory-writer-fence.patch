+// Runs on the debugger thread; the CPU owner continues its nonblocking fence polling.
+static bool WaitForLoadedMemoryPark(std::chrono::steady_clock::time_point deadline) {
+	while (!Core_EmucapMemoryParked()) {
+		if (coreState != CORE_STEPPING_CPU || std::chrono::steady_clock::now() >= deadline)
+			return false;
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+	return true;
+}
 
