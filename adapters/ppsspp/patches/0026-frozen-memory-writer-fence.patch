 // Step command to execute next
 static std::recursive_mutex g_stepMutex;
 static std::atomic<uint64_t> g_emucapMemoryEpoch{1};
+// Protected by g_stepMutex. Only the unwound CPU owner issues/polls the fence.
+static uint64_t g_emucapFenceEpoch = 0;
+static uint64_t g_emucapIoFence = 0;
+static std::atomic<uint64_t> g_emucapPublishedMemoryEpoch{0};
+
+void Core_EmucapInvalidateMemoryPark() {
+	std::lock_guard<std::recursive_mutex> guard(g_stepMutex);
+	g_emucapPublishedMemoryEpoch.store(0, std::memory_order_release);
+	++g_emucapMemoryEpoch;
+}
+
+static bool Core_EmucapPollMemoryPark(bool publish = true) {
+	const uint64_t epoch = g_emucapMemoryEpoch.load();
+	if (g_emucapFenceEpoch != epoch) {
+		g_emucapPublishedMemoryEpoch.store(0, std::memory_order_release);
+		g_emucapFenceEpoch = epoch;
+		g_emucapIoFence = __IoBeginMemoryFence();
+	}
+	const bool ready = __IoMemoryFenceComplete(g_emucapIoFence);
+	if (ready && publish) g_emucapPublishedMemoryEpoch.store(epoch, std::memory_order_release);
+	return ready;
+}
 
