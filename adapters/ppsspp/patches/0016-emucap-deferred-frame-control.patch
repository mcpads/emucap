+void WebSocketSteppingState::CancelFrame(DebuggerRequest &req) {
+	std::string operation;
+	if (!req.ParamString("operation_id", &operation))
+		return;
+	if (emucapFrameOwner != this || operation.empty() || operation != frameOperation_)
+		return req.Fail("frame operation identity does not belong to this connection");
