+void WebSocketSteppingState::CloseFrame() {
+	if (emucapFrameOwner != this)
+		return;
+	RequestFrameStop("connection_lost");
+	while (!Core_IsInactive()) {
+		if (std::chrono::steady_clock::now() >= frameStopDeadline_)
+			std::abort();
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+	if (coreState != CORE_STEPPING_CPU)
+		std::abort();
+	Core_EmucapCancelFrameStep();
+	emucapFrameOwner = nullptr;
