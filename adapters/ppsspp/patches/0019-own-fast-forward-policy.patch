@@ -7,6 +7,7 @@
 // any core, audio, UI, socket or lifecycle operation.
 struct EmucapPacingSnapshot {
     int percent = 100;
+    bool fastForward = false;
     uint32_t revision = 0;
 };
 
@@ -30,7 +31,25 @@
         return {previous, policy_};
     }
 
+    void InitializeFastForward(bool value) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        if (!initialized_) {
+            policy_.fastForward = value;
+            ++policy_.revision;
+            initialized_ = true;
+        }
+    }
+
+    EmucapPacingUpdate SetFastForward(bool value) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        const auto previous = policy_;
+        policy_.fastForward = value;
+        ++policy_.revision;
+        return {previous, policy_};
+    }
+
 private:
+    bool initialized_ = false;
     mutable std::mutex mutex_;
     EmucapPacingSnapshot policy_;
 };
