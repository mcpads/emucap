+// Read or set agent pacing (emucap.pacing)
+//
+// Parameters (neither queries):
+//  - percent: 1..10000 percent of the PSP refresh.
+//  - unlimited: true to run unthrottled.
+//
+// Response: percent (0 is unlimited), fast_forward, fps_limit (0 normal, 1/2 custom, 3 analog),
+// network_forced, revision (changes with any of these), vblank.
+void WebSocketSteppingState::Pacing(DebuggerRequest &req) {
+	const bool unlimited = req.HasParam("unlimited");
+	if (unlimited && req.HasParam("percent"))
+		return req.Fail("use percent or unlimited, not both");
+	if (unlimited) {
+		bool value = false;
+		if (!req.ParamBool("unlimited", &value) || !value)
+			return req.Fail("unlimited must be true");
+		__DisplaySetEmucapSpeed(0);
+	} else if (req.HasParam("percent")) {
+		uint32_t percent = 0;
+		if (!req.ParamU32("percent", &percent))
+			return;
+		if (percent == 0 || percent > 10000)
+			return req.Fail("percent must be between 1 and 10000");
+		__DisplaySetEmucapSpeed((int)percent);
+	}
+	const int percent = __DisplayGetEmucapSpeed();
+	const bool fastForward = PSP_CoreParameter().fastForward;
+	const int fpsLimit = (int)PSP_CoreParameter().fpsLimit;
+	const bool networkForced = !NetworkAllowSpeedControl();
+	static std::string lastKey;
+	static uint32_t revision = 0;
+	const std::string key = StringFromFormat("%d|%d|%d|%d", percent, fastForward, fpsLimit, networkForced);
+	if (key != lastKey) {
+		lastKey = key;
+		revision++;
+	}
+	JsonWriter &json = req.Respond();
+	json.writeUint("percent", (uint32_t)percent);
+	json.writeBool("fast_forward", fastForward);
+	json.writeUint("fps_limit", (uint32_t)fpsLimit);
+	json.writeBool("network_forced", networkForced);
+	json.writeUint("revision", revision);
+	json.writeUint("vblank", (uint32_t)__DisplayGetNumVblanks());
+}
