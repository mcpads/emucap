         policy_.fpsLimit = fps == 60 ? FPSLimit::NORMAL : FPSLimit::ANALOG;
         ++policy_.revision;
         return true;
+    }
+
+    void ConfigureLimits(int custom1, int custom2, int analog) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        if (policy_.customFps1 == custom1 && policy_.customFps2 == custom2 &&
+            policy_.analogTargetFps == analog)
+            return;
+        policy_.customFps1 = custom1;
+        policy_.customFps2 = custom2;
+        policy_.analogTargetFps = analog;
+        ++policy_.revision;
     }
 
