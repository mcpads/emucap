+// Serialize a debugger observation against resume and instruction stepping. Never pauses/resumes.
+bool Core_EmucapWithHaltedCPU(const std::function<bool(uint64_t)> &read) {
+    std::lock_guard<std::recursive_mutex> guard(g_stepMutex);
+    if (coreState != CORE_STEPPING_CPU || !g_cpuStepCommand.empty()) return false;
+    if (Core_IsActive()) return false;
+    return read(g_emucapMemoryEpoch.load());
