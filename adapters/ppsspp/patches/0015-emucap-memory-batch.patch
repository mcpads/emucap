+static bool EmucapBatchRanges(const std::string &text, std::vector<std::pair<uint32_t, uint32_t>> &ranges, uint32_t &total, uint32_t limit, uint32_t window) {
+  size_t at = 0;
+  auto number = [&](uint32_t &value) {
+    value = 0; size_t begin = at;
+    while (at < text.size()) {
+      char c = text[at];
+      unsigned digit = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : 16;
+      if (digit == 16) break;
+      if (value > (UINT32_MAX - digit) / 16) return false;
+      value = value * 16 + digit; ++at;
+    }
+    return at > begin;
+  };
+  total = 0;
+  while (at < text.size()) {
+    uint32_t address, length;
+    if (ranges.size() == 64 || !number(address) || at == text.size() || text[at++] != ',' || !number(length)) return false;
+    if (!length || address >= window || length > window - address || length > limit - total) return false;
+    total += length; ranges.emplace_back(address, length);
+    if (at == text.size()) return true;
+    if (text[at++] != ';' || at == text.size()) return false;
+  }
+  return false;
+}
+
+extern bool Core_EmucapWithHaltedCPU(const std::function<bool(uint64_t)> &read);
+static void EmucapMemoryBatch(DebuggerRequest &req) {
+    std::string descriptors;
+    if (!req.ParamString("ranges", &descriptors)) return;
+    std::vector<std::pair<uint32_t, uint32_t>> ranges;
+    uint32_t total = 0;
+    if (!EmucapBatchRanges(descriptors, ranges, total, 65536, 24 * 1024 * 1024))
+        return req.Fail("invalid memory batch ranges");
+    std::string bytes;
+    uint64_t frame = 0, epoch = 0;
+    bool success = Core_EmucapWithHaltedCPU([&](uint64_t stopEpoch) {
+        Memory::MemoryInitedLock lock;
+        if (!Memory::IsActive()) return false;
+        for (const auto &range : ranges)
+            if (!Memory::IsValidRange(0x08800000 + range.first, range.second)) return false;
+        bytes.reserve(total);
+        for (const auto &range : ranges)
+            bytes.append((const char *)Memory::GetPointerUnchecked(0x08800000 + range.first), range.second);
+        epoch = stopEpoch; frame = __DisplayGetNumVblanks();
+        return true;
+    });
+    if (!success) return req.Fail("memory batch requires an inactive halted CPU and live RAM");
+    const char *digits = "0123456789abcdef";
+    std::string hex; hex.reserve(bytes.size() * 2);
+    for (unsigned char byte : bytes) { hex += digits[byte >> 4]; hex += digits[byte & 15]; }
+    JsonWriter &json = req.Respond();
+    json.writeString("hex", hex);
+    json.writeUint("frame", frame);
+    json.writeUint("epoch", epoch);
+}
