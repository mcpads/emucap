+bool PCE_ResumeCompletedFrame(void)
+{
+ if(!vce->FrameCompleted())
+  return false;
+ // The old destination's pending output belongs to its abandoned frame.
+ es->SoundBufSize_InternalProcessed = es->SoundBufSize_DriverProcessed = 0;
+ es->MasterCycles_InternalProcessed = es->MasterCycles_DriverProcessed = 0;
+ restored_clock = false;
+ // Output formats were already applied on entry to the suspended call.
+ BeginFrame(es, false);
+ INPUT_Frame();
+ return true;
+}
