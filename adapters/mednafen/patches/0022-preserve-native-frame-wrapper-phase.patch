+void emucap_resume_frame_output()
+{
+ EmucapOutputCall.resume([](Mednafen::EmulateSpecStruct& spec) {
+  // The old call's processed output belongs to the abandoned destination frame.
+  spec.SoundBufSize_InternalProcessed = spec.SoundBufSize_DriverProcessed = 0;
+  spec.MasterCycles_InternalProcessed = spec.MasterCycles_DriverProcessed = 0;
+  spec.MasterCycles = 0;
+  spec.VideoFormatChanged = spec.SoundFormatChanged = false;
+  spec.InterlaceOn = spec.InterlaceField = false;
+  Mednafen::PrepareFrameOutput(&spec);
+ });
+}
