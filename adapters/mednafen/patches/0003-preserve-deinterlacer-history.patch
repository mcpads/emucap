+#ifndef MDFN_VIDEO_HISTORY_IO_H
+#define MDFN_VIDEO_HISTORY_IO_H
+#include <mednafen/Stream.h>
+#include "surface.h"
+#include "emucap_video_format.h"
+
+namespace Mednafen { namespace VideoHistoryIO {
+static const uint64 MaxBytes = 64ULL * 1024 * 1024;
+inline void RequireBytes(Stream* stream, uint64 count)
+{
+ const auto pos = stream->tell(), size = stream->size();
+ if(pos > size || count > size - pos)
+  throw std::runtime_error("truncated video history");
+}
+inline void WriteHeader(Stream* stream, uint32 type)
+{
+ stream->write("ECDEINT1", 8);
+ stream->put_LE<uint32>(type);
+}
+inline void ReadHeader(Stream* stream, uint32 type)
+{
+ char magic[8]; stream->read(magic, sizeof(magic));
+ if(memcmp(magic, "ECDEINT1", 8) || stream->get_LE<uint32>() != type)
+  throw std::runtime_error("incompatible deinterlacer history");
+}
+inline bool ReadBool(Stream* stream)
+{
+ const auto value = stream->get_LE<uint32>();
+ if(value > 1) throw std::runtime_error("invalid video history validity");
+ return value;
+}
+inline void WriteSurface(Stream* stream, const MDFN_Surface* surface)
+{
+ stream->put_LE<uint32>(surface ? 1 : 0);
+ if(!surface) return;
+ const unsigned opp = emucap_video_pixel_bytes(surface->format.tag);
+ if(surface->w <= 0 || surface->h <= 0 || surface->pitchinpix < surface->w
+    || uint64(surface->pitchinpix) * surface->h * opp > MaxBytes)
+  throw std::runtime_error("invalid video history surface");
+ stream->put_LE<uint32>(surface->w);
+ stream->put_LE<uint32>(surface->h);
+ stream->put_LE<uint64>(surface->format.tag);
+ std::vector<uint8> data(uint64(surface->w) * surface->h * opp);
+ for(int32 y = 0; y < surface->h; ++y)
+  for(int32 x = 0; x < surface->w; ++x)
+  {
+   const size_t index = size_t(y) * surface->pitchinpix + x;
+   uint8* dest = data.data() + (size_t(y) * surface->w + x) * opp;
+   if(opp == 2) MDFN_en16lsb(dest, surface->pixels16[index]);
+   else MDFN_en32lsb(dest, surface->pixels[index]);
+  }
+ stream->write(data.data(), data.size());
+}
+inline std::unique_ptr<MDFN_Surface> ReadSurface(Stream* stream, uint32 max_width, uint32 max_height)
+{
+ if(!ReadBool(stream)) return nullptr;
+ const auto w = stream->get_LE<uint32>(), h = stream->get_LE<uint32>();
+ const auto tag = stream->get_LE<uint64>();
+ const unsigned opp = emucap_video_pixel_bytes(tag);
+ if(!w || !h || w > max_width || h > max_height
+    || w > MaxBytes / opp || h > MaxBytes / (uint64(w) * opp))
+  throw std::runtime_error("invalid video history surface bounds");
+ const uint64 size = uint64(w) * h * opp;
+ RequireBytes(stream, size);
+ std::vector<uint8> data(size);
+ stream->read(data.data(), data.size());
+ std::unique_ptr<MDFN_Surface> result(new MDFN_Surface(nullptr, w, h, w, MDFN_PixelFormat(tag)));
+ for(size_t i = 0; i < size / opp; ++i)
+ {
+  if(opp == 2) result->pixels16[i] = MDFN_de16lsb(data.data() + i * opp);
+  else result->pixels[i] = MDFN_de32lsb(data.data() + i * opp);
+ }
+ return result;
+}
+inline void WriteWidths(Stream* stream, const int32* widths, uint32 count)
+{
+ if(count > MaxBytes / sizeof(int32)) throw std::runtime_error("invalid video history width count");
+ stream->put_LE<uint32>(count);
+ for(uint32 i = 0; i < count; ++i) stream->put_LE<uint32>(widths[i]);
+}
+inline std::vector<int32> ReadWidths(Stream* stream, uint32 count, uint32 max_width)
+{
+ if(stream->get_LE<uint32>() != count || count > MaxBytes / sizeof(int32))
+  throw std::runtime_error("invalid video history width count");
+ RequireBytes(stream, uint64(count) * sizeof(int32));
+ std::vector<int32> widths(count);
+ for(auto& width : widths)
+ {
+  const auto value = stream->get_LE<uint32>();
+  if(!value || value > max_width) throw std::runtime_error("invalid video history row width");
+  width = value;
+ }
+ return widths;
+}
+inline MDFN_Rect ReadRect(Stream* stream, uint32 max_width, uint32 max_height)
+{
+ const uint32 x = stream->get_LE<uint32>(), y = stream->get_LE<uint32>();
+ const uint32 w = stream->get_LE<uint32>(), h = stream->get_LE<uint32>();
+ if(x >= max_width || y >= max_height || w > max_width - x || h > max_height - y)
+  throw std::runtime_error("invalid video history rectangle");
+ return MDFN_Rect{int32(x), int32(y), int32(w), int32(h)};
+}
+} }
+#endif
