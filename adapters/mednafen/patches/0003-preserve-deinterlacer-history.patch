+std::unique_ptr<Deinterlacer> Deinterlacer::RestoreHistory(unsigned type, Stream* stream, uint32 max_width, uint32 max_height)
+{
+ if(type > DEINT_BLEND_RG || !max_width || !max_height
+    || max_width > VideoHistoryIO::MaxBytes / 2
+    || max_height > VideoHistoryIO::MaxBytes / sizeof(int32))
+  throw std::runtime_error("invalid deinterlacer history configuration");
+ VideoHistoryIO::ReadHeader(stream, type);
+ std::unique_ptr<Deinterlacer> result(Create(type));
+ result->LoadHistory(stream, max_width, max_height);
+ if(stream->tell() != stream->size())
+  throw std::runtime_error("trailing deinterlacer history data");
+ return result;
 }
