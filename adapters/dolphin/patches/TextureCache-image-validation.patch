+
+std::optional<u32> TextureConfig::GetSerializedSize(u32 max_texture_size) const
+{
+  constexpr u32 max_size = std::numeric_limits<u32>::max();
+  constexpr u32 known_flags = AbstractTextureFlag_RenderTarget | AbstractTextureFlag_ComputeImage;
+  if (width == 0 || height == 0 || width > max_texture_size || height > max_texture_size ||
+      width > max_size / 8 || height > static_cast<u32>(std::numeric_limits<int>::max()) ||
+      levels == 0 || levels > static_cast<u32>(std::bit_width(std::max(width, height))) || layers == 0 || samples != 1 ||
+      format >= AbstractTextureFormat::Undefined || type > AbstractTextureType::Texture_CubeMap ||
+      (flags & ~known_flags) != 0)
+    return std::nullopt;
+
+  // Preserve the existing payload layout, including compressed-format row extents.
+  // Calculate one layer first so an untrusted layer count cannot drive a large loop.
+  u64 layer_size = 0;
+  for (u32 level = 0; level < levels; ++level)
+  {
+    layer_size += static_cast<u64>(GetMipStride(level)) * std::max(height >> level, 1u);
+    if (layer_size > max_size)
+      return std::nullopt;
+  }
+  if (layer_size == 0 || layer_size > max_size / layers)
+    return std::nullopt;
+  return static_cast<u32>(layer_size * layers);
+}
