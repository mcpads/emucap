+std::string GenerateEFBSamplePixelShader(bool depth, bool restore)
+{
+  ShaderCode code;
+  EmitUniformBufferDeclaration(code);
+  code.Write("{{ int sample_index; int pad0; int pad1; int pad2; }};\n");
+  EmitSamplerDeclarations(code, 0, restore ? 2 : 1, !restore);
+  EmitPixelMainDeclaration(code, 1, 0, depth ? "float" : "float4", "");
+  code.Write("{{\n  int3 coords = int3(int2(gl_FragCoord.xy), int(v_tex0.z));\n");
+  if (restore)
+  {
+    code.Write("  if (gl_SampleID != sample_index) discard;\n"
+               "  ocol0 = texelFetch(samp0, coords, 0);\n"
+               "  gl_FragDepth = texelFetch(samp1, coords, 0).r;\n");
+  }
+  else
+  {
+    code.Write("  ocol0 = texelFetch(samp0, coords, sample_index){};\n", depth ? ".r" : "");
+  }
+  code.Write("}}\n");
+  return code.GetBuffer();
+}
