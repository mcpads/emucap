+bool FramebufferManager::CompileSampleStatePipelines()
+{
+  if (m_sample_color_pipeline && m_sample_depth_pipeline && m_sample_restore_pipeline)
+    return true;
+  AbstractPipelineConfig config = {};
+  config.vertex_shader = g_shader_cache->GetScreenQuadVertexShader();
+  config.geometry_shader = IsEFBStereo() ? g_shader_cache->GetTexcoordGeometryShader() : nullptr;
+  config.rasterization_state = RenderState::GetNoCullRasterizationState(PrimitiveType::Triangles);
+  config.depth_state = RenderState::GetNoDepthTestingDepthState();
+  config.blending_state = RenderState::GetNoBlendingBlendState();
+  config.usage = AbstractPipelineUsage::Utility;
+  auto color_shader = g_gfx->CreateShaderFromSource(ShaderStage::Pixel,
+      FramebufferShaderGen::GenerateEFBSamplePixelShader(false, false), nullptr, "EFB color sample");
+  auto depth_shader = g_gfx->CreateShaderFromSource(ShaderStage::Pixel,
+      FramebufferShaderGen::GenerateEFBSamplePixelShader(true, false), nullptr, "EFB depth sample");
+  auto restore_shader = g_gfx->CreateShaderFromSource(ShaderStage::Pixel,
+      FramebufferShaderGen::GenerateEFBSamplePixelShader(false, true), nullptr, "EFB sample restore");
+  if (!color_shader || !depth_shader || !restore_shader)
+    return false;
+  config.pixel_shader = color_shader.get();
+  config.framebuffer_state = RenderState::GetColorFramebufferState(GetEFBColorFormat());
+  auto color = g_gfx->CreatePipeline(config);
+  config.pixel_shader = depth_shader.get();
+  config.framebuffer_state = RenderState::GetColorFramebufferState(GetEFBDepthCopyFormat());
+  auto depth = g_gfx->CreatePipeline(config);
+  config.pixel_shader = restore_shader.get();
+  config.depth_state = RenderState::GetAlwaysWriteDepthState();
+  config.framebuffer_state = GetEFBFramebufferState();
+  config.framebuffer_state.per_sample_shading = true;
+  auto restore = g_gfx->CreatePipeline(config);
+  if (!color || !depth || !restore)
+    return false;
+  m_sample_color_pipeline = std::move(color);
+  m_sample_depth_pipeline = std::move(depth);
+  m_sample_restore_pipeline = std::move(restore);
+  return true;
+}
+
+void FramebufferManager::DoSampleState(PointerWrap& p, u32 samples)
+{
+  const TextureConfig color_config(GetEFBWidth(), GetEFBHeight(), 1,
+      m_efb_color_texture->GetLayers(), 1, GetEFBColorFormat(), 0,
+      AbstractTextureType::Texture_2DArray);
+  const TextureConfig depth_config(GetEFBWidth(), GetEFBHeight(), 1,
+      m_efb_depth_texture->GetLayers(), 1, GetEFBDepthCopyFormat(), 0,
+      AbstractTextureType::Texture_2DArray);
+  if (p.IsMeasureMode())
+  {
+    for (u32 i = 0; i < samples && !p.HasError(); ++i)
+    {
+      g_texture_cache->SerializeTexture(nullptr, color_config, p);
+      g_texture_cache->SerializeTexture(nullptr, depth_config, p);
+    }
+    return;
+  }
+  if (!CompileSampleStatePipelines())
+  {
+    p.SetError();
+    return;
+  }
+  if (p.IsWriteMode())
+  {
+    auto color_target = color_config;
+    auto depth_target = depth_config;
+    color_target.flags = AbstractTextureFlag_RenderTarget;
+    depth_target.flags = AbstractTextureFlag_RenderTarget;
+    auto color = g_gfx->CreateTexture(color_target, "EFB sample color staging source");
+    auto depth = g_gfx->CreateTexture(depth_target, "EFB sample depth staging source");
+    if (!color || !depth)
+    {
+      p.SetError();
+      return;
+    }
+    auto color_fb = g_gfx->CreateFramebuffer(color.get(), nullptr);
+    auto depth_fb = g_gfx->CreateFramebuffer(depth.get(), nullptr);
+    if (!color_fb || !depth_fb)
+    {
+      p.SetError();
+      return;
+    }
+    for (u32 i = 0; i < samples && !p.HasError(); ++i)
+    {
+      const std::array<s32, 4> uniforms{static_cast<s32>(i), 0, 0, 0};
+      for (bool is_depth : {false, true})
+      {
+        auto* source = is_depth ? m_efb_depth_texture.get() : m_efb_color_texture.get();
+        auto* destination = is_depth ? depth.get() : color.get();
+        g_gfx->BeginUtilityDrawing();
+        source->FinishedRendering();
+        g_gfx->SetAndDiscardFramebuffer(is_depth ? depth_fb.get() : color_fb.get());
+        g_gfx->SetViewportAndScissor(destination->GetRect());
+        g_gfx->SetPipeline(is_depth ? m_sample_depth_pipeline.get() : m_sample_color_pipeline.get());
+        g_gfx->SetTexture(0, source);
+        g_gfx->SetSamplerState(0, RenderState::GetPointSamplerState());
+        g_vertex_manager->UploadUtilityUniforms(uniforms.data(), sizeof(uniforms));
+        g_gfx->Draw(0, 3);
+        destination->FinishedRendering();
+        g_gfx->EndUtilityDrawing();
+        g_texture_cache->SerializeTexture(destination, is_depth ? depth_config : color_config, p);
+        if (p.HasError())
+          return;
+      }
+    }
+    return;
+  }
+  struct PlanePair
+  {
+    std::unique_ptr<AbstractTexture> color;
+    std::unique_ptr<AbstractTexture> depth;
+  };
+  std::vector<PlanePair> planes;
+  for (u32 i = 0; i < samples; ++i)
+  {
+    auto color = g_texture_cache->DeserializeTexture(p);
+    auto depth = g_texture_cache->DeserializeTexture(p);
+    if (p.HasError() || !color || !depth ||
+        color->texture->GetConfig() != color_config || depth->texture->GetConfig() != depth_config)
+    {
+      p.SetError();
+      return;
+    }
+    planes.push_back({std::move(color->texture), std::move(depth->texture)});
+  }
+  InvalidatePeekCache(true);
+  g_gfx->BeginUtilityDrawing();
+  g_gfx->SetAndDiscardFramebuffer(m_efb_framebuffer.get());
+  g_gfx->SetViewportAndScissor(m_efb_framebuffer->GetRect());
+  g_gfx->SetPipeline(m_sample_restore_pipeline.get());
+  g_gfx->SetSamplerState(0, RenderState::GetPointSamplerState());
+  g_gfx->SetSamplerState(1, RenderState::GetPointSamplerState());
+  for (u32 i = 0; i < samples; ++i)
+  {
+    const std::array<s32, 4> uniforms{static_cast<s32>(i), 0, 0, 0};
+    g_gfx->SetTexture(0, planes[i].color.get());
+    g_gfx->SetTexture(1, planes[i].depth.get());
+    g_vertex_manager->UploadUtilityUniforms(uniforms.data(), sizeof(uniforms));
+    g_gfx->Draw(0, 3);
+  }
+  g_gfx->EndUtilityDrawing();
+}
