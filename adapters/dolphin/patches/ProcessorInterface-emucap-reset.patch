+void ProcessorInterfaceManager::EmucapResetButtonTap(u64 token)
+{
+  ASSERT(token != 0 && token <= (std::numeric_limits<u64>::max() >> 1));
+  auto& core_timing = m_system.GetCoreTiming();
+  core_timing.ScheduleEvent(0, m_event_type_emucap_toggle_reset_button, (token << 1) | 1,
+                            CoreTiming::FromThread::ANY);
+  core_timing.ScheduleEvent(0, m_event_type_ios_notify_reset_button, 0,
+                            CoreTiming::FromThread::ANY);
+  core_timing.ScheduleEvent(m_system.GetSystemTimers().GetTicksPerSecond() / 2,
+                            m_event_type_emucap_toggle_reset_button, token << 1,
+                            CoreTiming::FromThread::ANY);
+}
+
+void ProcessorInterfaceManager::CancelEmucapResetButtonTap()
+{
+  ASSERT(Core::IsCPUThread());
+  auto& core_timing = m_system.GetCoreTiming();
+  core_timing.RemoveAllEvents(m_event_type_emucap_toggle_reset_button);
+  SetResetButton(false);
+}
