+void ProcessorInterfaceManager::EmucapToggleResetButtonCallback(Core::System& system, u64 userdata,
+                                                                s64 cyclesLate)
+{
+  const bool pressed = (userdata & 1) != 0;
+  const u64 token = userdata >> 1;
+  system.GetProcessorInterface().SetResetButton(pressed);
+  if (!pressed)
+    EmuCap::NotifyResetTapComplete(system, token);
+}
