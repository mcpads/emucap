@@ -415,10 +416,18 @@ void CoreTimingManager::SleepUntil(TimePoint time_point)
   {
     const TimePoint time = Clock::now();
 
-    if (use_precision_timer)
-      m_precision_cpu_timer.SleepUntil(time_point);
-    else
-      std::this_thread::sleep_until(time_point);
+    // Sleep in slices so a pause or CPU lock request is not held behind a long throttle target at
+    // a slow emulation speed. The skipped time stays owed through the throttle reference.
+    const auto& cpu = m_system.GetCPU();
+    TimePoint slice_end = time;
+    while (slice_end < time_point && cpu.GetState() == CPU::State::Running)
+    {
+      slice_end = std::min(time_point, Clock::now() + std::chrono::milliseconds(10));
+      if (use_precision_timer)
+        m_precision_cpu_timer.SleepUntil(slice_end);
+      else
+        std::this_thread::sleep_until(slice_end);
+    }
 
     // Count amount of time sleeping for analytics
     const TimePoint time_after_sleep = Clock::now();
@@ -513,6 +522,11 @@ void CoreTimingManager::UpdateSpeedLimit(s64 cycle, double new_speed)
   m_throttle_adj_clock_per_sec = new_clock_per_sec;
 }
 
