+bool DSPLLE::EmucapTryLockIdle()
+{
+  if (!m_dsp_thread_mutex.try_lock()) return false;
+  if (m_cycle_count.load() != 0)
+  {
+    m_dsp_thread_mutex.unlock();
+    return false;
+  }
+  return true;
+}
+
+void DSPLLE::EmucapUnlockIdle()
+{
+  // Observation must not signal or schedule the DSP worker.
+  m_dsp_thread_mutex.unlock();
+}
