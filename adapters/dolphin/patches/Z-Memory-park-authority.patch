+bool CPUManager::EmucapWithParkedCPU(const std::function<bool(uint64_t)>& callback)
+{
+  std::unique_lock stepping_lock(m_stepping_lock, std::try_to_lock);
+  if (!stepping_lock) return false;
+  std::unique_lock state_lock(m_state_change_lock, std::try_to_lock);
+  if (!state_lock || m_state != State::Stepping || m_state_cpu_thread_active ||
+      m_state_cpu_step_instruction || m_state_paused_and_locked || !m_pending_jobs.empty() ||
+      (m_emucap_job_active && !Core::IsCPUThread()))
+    return false;
+  return callback(m_emucap_memory_epoch);
+}
