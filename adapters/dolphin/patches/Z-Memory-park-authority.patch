+u64 EmucapWithParkedMemory(System& system, u64 expected_epoch,
+                           const std::function<void()>& callback)
+{
+  u64 verified = 0;
+  system.GetCPU().EmucapWithParkedCPU([&](u64 epoch) {
+    if (expected_epoch && expected_epoch != epoch) return false;
+    auto* dsp = system.GetDSP().GetDSPEmulator();
+    if (!dsp || !dsp->EmucapTryLockIdle()) return false;
+    Common::ScopeGuard unlock([&] { dsp->EmucapUnlockIdle(); });
+    if (!system.GetFifo().EmucapMemoryIdle()) return false;
+    callback();
+    verified = epoch;
+    return true;
+  });
+  return verified;
+}
