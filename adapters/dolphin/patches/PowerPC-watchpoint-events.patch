+bool MemChecks::AddEmuCap(TMemCheck memory_check, u32 ambiguity_margin)
+{
+  if (memory_check.emucap_breakpoint_id == 0)
+    return false;
+
+  {
+    const Core::CPUThreadGuard guard(m_system);
+    const u64 start = memory_check.start_address;
+    const u64 end = memory_check.end_address;
+    const bool conflicts = std::ranges::any_of(m_mem_checks, [&](const TMemCheck& existing) {
+      return static_cast<u64>(existing.start_address) <= end + ambiguity_margin &&
+             start <= static_cast<u64>(existing.end_address) + ambiguity_margin;
+    });
+    if (conflicts)
+      return false;
+    m_mem_checks.emplace_back(std::move(memory_check));
+  }
+  Update();
+  return true;
+}
+
+bool MemChecks::RemoveEmuCap(u64 id)
+{
+  bool removed = false;
+  {
+    const Core::CPUThreadGuard guard(m_system);
+    const auto iter = std::ranges::find(m_mem_checks, id, &TMemCheck::emucap_breakpoint_id);
+    if (iter != m_mem_checks.end())
+    {
+      m_mem_checks.erase(iter);
+      removed = true;
+    }
+  }
+  if (removed)
+    Update();
+  return removed;
+}
