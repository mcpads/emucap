+void RunOnCPUThreadWithHostLock(Core::System& system, Common::MoveOnlyFunction<void()> function)
+{
+  RunOnCPUThread(system, [function = std::move(function)]() mutable {
+    std::lock_guard lock(s_core_mutex);
+    function();
+  });
