diff --git a/Source/Core/Core/HW/CPU.cpp b/Source/Core/Core/HW/CPU.cpp
--- a/Source/Core/Core/HW/CPU.cpp
+++ b/Source/Core/Core/HW/CPU.cpp
@@ -167,6 +167,7 @@
           // If we are still going to step, emulate the fact we just sent a step command
           if (GDBStub::HasControl())
           {
+            std::lock_guard sync_lock(m_state_change_lock);
             // Make sure the previous step by gdb was serviced
             if (m_state_cpu_step_instruction_sync &&
                 m_state_cpu_step_instruction_sync != &gdb_step_sync_event)
@@ -286,6 +287,23 @@
   m_state_cpu_step_instruction_sync = event;
   m_state_cpu_cvar.notify_one();
 }
+bool CPUManager::ReleaseStepEvent(Common::Event* event)
+{
+  std::lock_guard state_lock(m_state_change_lock);
+
+  // Even a successful Event::Wait can return before Event::Set finishes notifying. Acquiring
+  // the publisher's lock fences notification before the caller destroys the event.
+  // A completed or superseded request no longer retains this event. In that case the caller may
+  // restore the previous core mode only after the CPU thread has also become idle.
+  if (m_state_cpu_step_instruction_sync != event)
+    return !m_state_cpu_thread_active;
+
+  // Detach the caller-owned event before it leaves scope. If SingleStep is already executing, it
+  // may still finish later, so report that the caller must leave the interpreter selected.
+  m_state_cpu_step_instruction_sync = nullptr;
+  m_state_cpu_step_instruction = false;
+  return !m_state_cpu_thread_active;
+}
 
 // Requires m_state_change_lock
 bool CPUManager::SetStateLocked(State s)
