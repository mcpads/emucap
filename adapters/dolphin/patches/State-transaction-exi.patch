+void ExpansionInterfaceManager::BeginStateLoad()
+{
+  m_pending_memory_card_reloads.clear();
+}
+
+void ExpansionInterfaceManager::QueueMemoryCardReload(u8 channel, u8 device_num)
+{
+  m_pending_memory_card_reloads.emplace_back(channel, device_num);
+}
+
+void ExpansionInterfaceManager::FinishStateLoad(bool loaded)
+{
+  auto pending = std::exchange(m_pending_memory_card_reloads, {});
+  if (!loaded)
+    return;
+
+  for (const auto& [channel, device_num] : pending)
+  {
+    // Preserve the card migration policy, but schedule against the fully restored CPU clock.
+    m_channels.at(channel)->AddDevice(EXIDeviceType::None, device_num);
+    ChangeDevice(channel, device_num, EXIDeviceType::MemoryCardFolder, CoreTiming::FromThread::CPU);
+  }
+}
