+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <mutex>
+
+// PINE exchanges copy receipts under the mutex; only Service() calls the CPU host.
+// No host call holds the mutex, so a stalled CPU/GS cannot stall a receipt query.
+namespace EmuCap
+{
+enum class FramePhase : uint32_t { Queued, Running, Stopping, Terminal, Finishing, Finished, Fault };
+enum class FrameReason : uint32_t { Completed, Cancelled, Deadline, ExternalStop, Rejected, Invalidated, CounterMismatch };
+struct FrameReceipt
+{
+	uint64_t id = 0, generation = 0, start = 0, end = 0;
+	uint32_t requested = 0, count = 0;
+	FramePhase phase = FramePhase::Queued;
+	FrameReason reason = FrameReason::Completed;
+};
+
+class FrameOperations
+{
+public:
+	using Clock = std::chrono::steady_clock;
+	struct Record
+	{
+		FrameReceipt receipt;
+		Clock::time_point deadline;
+		uint64_t terminal_epoch = 0;
+		bool cancel = false, detached = false, pause_only = false;
+	};
+	using Ticket = std::shared_ptr<Record>;
+
+	Ticket Begin(uint32_t count, uint32_t budget_ms, Clock::time_point now)
+	{
+		return Reserve(count, budget_ms, now, false);
+	}
+
+	Ticket BeginPause(uint32_t budget_ms, Clock::time_point now)
+	{
+		return Reserve(0, budget_ms, now, true);
+	}
+
+private:
+	Ticket Reserve(uint32_t count, uint32_t budget_ms, Clock::time_point now, bool pause_only)
+	{
+		std::lock_guard lock(m_mutex);
+		if ((!pause_only && !count) || count > 5000 || !budget_ms || budget_ms > 250000 ||
+			(m_current && m_current->receipt.phase != FramePhase::Finished) ||
+			m_next_id == std::numeric_limits<uint64_t>::max())
+			return {};
+		auto ticket = std::make_shared<Record>();
+		ticket->pause_only = pause_only;
+		ticket->receipt.id = ++m_next_id;
+		ticket->receipt.generation = m_generation;
+		ticket->receipt.requested = count;
+		ticket->deadline = now + std::chrono::milliseconds(budget_ms);
+		m_current = ticket;
+		return ticket;
+	}
+
+public:
+	Ticket Find(uint64_t id)
+	{
+		std::lock_guard lock(m_mutex);
+		return m_current && m_current->receipt.id == id ? m_current : Ticket{};
+	}
+
+	bool Read(const Ticket& ticket, FrameReceipt& receipt)
+	{
+		std::lock_guard lock(m_mutex);
+		if (!ticket || ticket != m_current) return false;
+		receipt = ticket->receipt;
+		return true;
+	}
+
+	bool Cancel(const Ticket& ticket)
+	{
+		std::lock_guard lock(m_mutex);
+		if (!ticket || ticket != m_current) return false;
+		ticket->cancel = true;
+		return true;
+	}
+
+	bool Finish(const Ticket& ticket)
+	{
+		std::lock_guard lock(m_mutex);
+		if (!ticket || ticket != m_current) return false;
+		auto& phase = ticket->receipt.phase;
+		if (phase == FramePhase::Terminal) phase = FramePhase::Finishing;
+		return phase == FramePhase::Finishing || phase == FramePhase::Finished;
+	}
+
+	bool OwnsExecution()
+	{
+		std::lock_guard lock(m_mutex);
+		return m_current && m_current->receipt.phase != FramePhase::Finished;
+	}
+
+	Ticket Detach()
+	{
+		std::lock_guard lock(m_mutex);
+		if (m_current) { m_current->cancel = true; m_current->detached = true; }
+		return m_current;
+	}
+
+	// Called on the CPU thread before reset/load/shutdown/initialization mutates a VM.
+	void Invalidate()
+	{
+		std::lock_guard lock(m_mutex);
+		++m_generation;
+		if (m_current && m_current->receipt.phase != FramePhase::Finished)
+		{
+			m_current->receipt.phase = FramePhase::Fault;
+			m_current->receipt.reason = FrameReason::Invalidated;
+		}
+	}
+
+	// CPU thread only. An empty expected ticket is used by native scheduler ticks.
+	// Queued callbacks always supply their original ticket, never a bare "current".
+	template <class Host>
+	void Service(Host& host, const Ticket& expected = {})
+	{
+		if (m_servicing) return;
+		Ticket ticket;
+		FrameReceipt receipt;
+		bool cancel, detached, pause_only;
+		Clock::time_point deadline;
+		uint64_t terminal_epoch;
+		{
+			std::lock_guard lock(m_mutex);
+			ticket = m_current;
+			if (!ticket || (expected && expected != ticket)) return;
+			receipt = ticket->receipt;
+			cancel = ticket->cancel; detached = ticket->detached; pause_only = ticket->pause_only;
+			deadline = ticket->deadline; terminal_epoch = ticket->terminal_epoch;
+		}
+		if (receipt.phase == FramePhase::Fault) return;
+		if (receipt.phase == FramePhase::Finished)
+		{
+			if (detached) { std::lock_guard lock(m_mutex); if (ticket == m_current) m_current.reset(); }
+			return;
+		}
+		m_servicing = true;
+		{
+			auto fault = [&](FrameReason reason) { receipt.phase = FramePhase::Fault; receipt.reason = reason; };
+			if (!host.Valid()) fault(FrameReason::Invalidated);
+			else if (receipt.phase == FramePhase::Finishing ||
+				(detached && receipt.phase == FramePhase::Terminal))
+			{
+				if (!host.Parked() || host.Frame() != receipt.end || host.Epoch() != terminal_epoch)
+					fault(FrameReason::Invalidated);
+				else receipt.phase = FramePhase::Finished;
+			}
+			else if (receipt.phase == FramePhase::Queued)
+			{
+				if (pause_only)
+				{
+					// Cleanup does not manufacture a zero-frame advance. It owns a
+					// pause and samples its clock only after execution has unwound.
+					if (host.Now() >= deadline) fault(FrameReason::Deadline);
+					else
+					{
+						if (host.Running()) host.Pause();
+						if (host.Parked())
+						{
+							host.ClearTarget();
+							receipt.start = receipt.end = host.Frame();
+							receipt.phase = FramePhase::Terminal;
+							terminal_epoch = host.Epoch();
+						}
+					}
+				}
+				else if (!host.Paused()) fault(FrameReason::Rejected);
+				else if (host.Parked())
+				{
+					receipt.start = receipt.end = host.Frame();
+					if (cancel || host.Now() >= deadline)
+					{
+						receipt.phase = FramePhase::Terminal;
+						receipt.reason = cancel ? FrameReason::Cancelled : FrameReason::Deadline;
+						terminal_epoch = host.Epoch();
+					}
+					else
+					{
+						host.ClearTarget();
+						host.Start(receipt.requested);
+						if (!host.Running()) fault(FrameReason::Rejected);
+						else receipt.phase = FramePhase::Running;
+					}
+				}
+			}
+			else if (receipt.phase == FramePhase::Running || receipt.phase == FramePhase::Stopping)
+			{
+				const uint64_t end = host.Frame();
+				const uint32_t remaining = host.Remaining();
+				if (end < receipt.start || end - receipt.start > receipt.requested ||
+					remaining > receipt.requested || end - receipt.start != receipt.requested - remaining)
+					fault(FrameReason::CounterMismatch);
+				else
+				{
+					receipt.end = end;
+					receipt.count = static_cast<uint32_t>(end - receipt.start);
+					if (host.Running() && (cancel || host.Now() >= deadline))
+					{
+						receipt.phase = FramePhase::Stopping;
+						receipt.reason = cancel ? FrameReason::Cancelled : FrameReason::Deadline;
+						host.Pause();
+					}
+					if (host.Parked())
+					{
+						host.ClearTarget();
+						if (receipt.count == receipt.requested) receipt.reason = FrameReason::Completed;
+						else if (receipt.phase != FramePhase::Stopping) receipt.reason = FrameReason::ExternalStop;
+						receipt.phase = FramePhase::Terminal;
+						terminal_epoch = host.Epoch();
+					}
+				}
+			}
+			// Disconnect has no caller left to request finish. Settle it at this
+			// verified boundary; a paused Qt loop need not schedule another tick.
+			{ std::lock_guard lock(m_mutex); detached = ticket->detached; }
+			if (detached && receipt.phase == FramePhase::Terminal)
+			{
+				if (!host.Parked() || host.Frame() != receipt.end || host.Epoch() != terminal_epoch)
+					fault(FrameReason::Invalidated);
+				else receipt.phase = FramePhase::Finished;
+			}
+			{
+				std::lock_guard lock(m_mutex);
+				// Lifecycle hooks may have invalidated the record inside a host call.
+				if (ticket == m_current && receipt.generation == m_generation &&
+					ticket->receipt.phase != FramePhase::Fault)
+				{
+					// A concurrent Finish request cannot be overwritten by a terminal poll.
+					if (ticket->receipt.phase == FramePhase::Finishing && receipt.phase == FramePhase::Terminal)
+						receipt.phase = FramePhase::Finishing;
+					ticket->receipt = receipt;
+					ticket->terminal_epoch = terminal_epoch;
+					if (ticket->detached && receipt.phase == FramePhase::Finished) m_current.reset();
+				}
+			}
+		}
+		m_servicing = false;
+	}
+
+private:
+	std::mutex m_mutex;
+	Ticket m_current;
+	uint64_t m_next_id = 0, m_generation = 1;
+	bool m_servicing = false; // CPU thread only.
+};
+} // namespace EmuCap
