+// GS history is variable-sized. The current renderer cannot determine a saved
+// entry's length, especially after reset, a resolution change or a legacy load.
+static bool SysState_GSFreezeIn(zip_file_t* zf)
+{
+ if (!zf) return true;
+ constexpr std::size_t limit = GSDeinterlaceHistory::MaxPixels * sizeof(u32) + 16 * 1024 * 1024;
+ std::vector<u8> data;
+ std::array<u8, 64 * 1024> block;
+ for (;;) {
+  const zip_int64_t count = zip_fread(zf, block.data(), block.size());
+  if (count < 0) return false;
+  if (!count) break;
+  if (static_cast<std::size_t>(count) > limit - data.size()) return false;
+  data.insert(data.end(), block.data(), block.data() + count);
+ }
+ if (data.empty()) return false;
+ freezeData state = {static_cast<int>(data.size()), data.data()};
+ return SysState_MTGSFreeze(FreezeAction::Load, &state) == 0;
+}
