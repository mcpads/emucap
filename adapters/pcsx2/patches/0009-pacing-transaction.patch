 float VMManager::GetNominalSpeed()
 {
 	return s_emucap_nominal_speed > 0.0f ? s_emucap_nominal_speed : EmuConfig.EmulationSpeed.NominalScalar;
+}
+
+
+VMManager::EmuCapPacingSnapshot VMManager::GetEmuCapPacingSnapshot()
+{
+	// All policy writers run on the CPU thread. Track updates here and in UpdateTargetSpeed,
+	// so an unobserved native A->B->A transition still changes the revision.
+	static EmuCapPacingSnapshot previous{};
+	static bool initialized = false;
+	EmuCapPacingSnapshot current{static_cast<u32>(GetLimiterMode()),
+		static_cast<u32>(std::lround(GetNominalSpeed() * 10000.0)), GetTargetSpeed(), previous.revision, g_FrameCount};
+	if (!initialized || current.mode != previous.mode || current.nominal != previous.nominal || current.target != previous.target)
+		current.revision++;
+	initialized = true;
+	previous = current;
+	return current;
 }
 
