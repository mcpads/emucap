+
+u32 VMManager::ApplyEmuCapPacing(u32 percent, EmuCapPacingSnapshot& previous, EmuCapPacingSnapshot& final)
+{
+	previous = GetEmuCapPacingSnapshot();
+	const float prior_override = s_emucap_nominal_speed;
+	const LimiterModeType prior_mode = s_limiter_mode;
+	if (!SetEmucapSpeedPercent(percent))
+	{
+		final = previous;
+		return 1;
+	}
+	final = GetEmuCapPacingSnapshot();
+	const bool verified = percent == 0 ?
+		(final.mode == static_cast<u32>(LimiterModeType::Unlimited) && final.target == 0.0f) :
+		(final.mode == static_cast<u32>(LimiterModeType::Nominal) && final.nominal == percent * 100 &&
+		 std::isfinite(final.target) && std::lround(final.target * 10000.0) == percent * 100);
+	if (verified)
+		return 0;
+
+	// Still on the same CPU callback: no newer settings writer can be overwritten.
+	s_emucap_nominal_speed = prior_override;
+	s_limiter_mode = prior_mode;
+	UpdateTargetSpeed();
+	final = GetEmuCapPacingSnapshot();
+	return final.mode == previous.mode && final.nominal == previous.nominal &&
+		final.target == previous.target ? 1 : 2;
 }
 
