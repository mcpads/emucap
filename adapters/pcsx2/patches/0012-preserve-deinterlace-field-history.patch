+
+// Optional GS-state trailer. All words are little-endian, independent of host alignment.
+struct GSDeinterlaceHistory
+{
+ struct Image { std::uint32_t width = 0, height = 0; std::vector<std::uint32_t> pixels; };
+ std::uint32_t index = 0;
+ std::array<Image, 2> images; // weave and motion-adaptive field history
+ static constexpr std::uint64_t MaxPixels = 64ull * 1024 * 1024;
+ static void Word(std::vector<std::uint8_t>& out, std::uint32_t value)
+ { for (unsigned n=0;n<4;n++) out.push_back(static_cast<std::uint8_t>(value >> (8*n))); }
+ std::vector<std::uint8_t> Encode() const
+ {
+  std::vector<std::uint8_t> out;
+  Word(out, 0x48494447); Word(out, 1); Word(out, index);
+  for (const Image& im : images) {
+   Word(out, im.width); Word(out, im.height);
+   for (auto pixel : im.pixels) Word(out, pixel);
+  }
+  return out;
+ }
+ static bool Decode(const std::uint8_t* data, std::size_t size, GSDeinterlaceHistory& output)
+ {
+  GSDeinterlaceHistory result;
+  if (!size) { output = std::move(result); return true; } // legacy GS state
+  auto word = [&](std::uint32_t& value) {
+   if (size < 4) return false;
+   value = std::uint32_t(data[0]) | (std::uint32_t(data[1]) << 8) |
+           (std::uint32_t(data[2]) << 16) | (std::uint32_t(data[3]) << 24);
+   data += 4; size -= 4; return true;
+  };
+  std::uint32_t magic, version;
+  if (!word(magic) || magic != 0x48494447 || !word(version) || version != 1 ||
+      !word(result.index) || result.index > 3) return false;
+  std::uint64_t total = 0;
+  for (Image& im : result.images) {
+   if (!word(im.width) || !word(im.height) || im.width > 16384 || im.height > 16384 ||
+       (im.width == 0) != (im.height == 0)) return false;
+   const std::uint64_t count = std::uint64_t(im.width) * im.height;
+   total += count;
+   if (total > MaxPixels || count > size / 4) return false;
+   im.pixels.resize(static_cast<std::size_t>(count));
+   for (auto& pixel : im.pixels) if (!word(pixel)) return false;
+  }
+  if (size) return false;
+  output = std::move(result); return true;
+ }
+};
