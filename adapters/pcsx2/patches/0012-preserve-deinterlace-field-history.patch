+bool GSDevice::CaptureDeinterlaceHistory(GSDeinterlaceHistory& history)
+{
+ GSDeinterlaceHistory captured;
+ captured.index = m_deinterlace_index;
+ GSTexture* textures[] = {m_weavebob, m_mad};
+ std::uint64_t total = 0;
+ for (unsigned i = 0; i < 2; i++) {
+  GSTexture* texture = textures[i];
+  if (!texture) continue;
+  auto& image = captured.images[i];
+  image.width = texture->GetWidth(); image.height = texture->GetHeight();
+  total += std::uint64_t(image.width) * image.height;
+  if (image.width > 16384 || image.height > 16384 || total > GSDeinterlaceHistory::MaxPixels) return false;
+  auto download = CreateDownloadTexture(image.width, image.height, GSTexture::Format::Color);
+  if (!download) return false;
+  const GSVector4i rect(0, 0, image.width, image.height);
+  download->CopyFromTexture(rect, texture, rect, 0); download->Flush();
+  if (!download->Map(rect)) return false;
+  image.pixels.resize(std::size_t(image.width) * image.height);
+  StringUtil::StrideMemCpy(image.pixels.data(), image.width * 4, download->GetMapPointer(),
+                         download->GetMapPitch(), image.width * 4, image.height);
+ }
+ history = std::move(captured); return true;
+}
+
+bool GSDevice::RestoreDeinterlaceHistory(const GSDeinterlaceHistory& history)
+{
+ // Allocate and upload before publishing either field history.
+ std::unique_ptr<GSTexture> restored[2];
+ for (unsigned i = 0; i < 2; i++) {
+  const auto& image = history.images[i];
+  if (!image.width) continue;
+  restored[i].reset(CreateRenderTarget(image.width, image.height, GSTexture::Format::Color, false));
+  if (!restored[i] || !restored[i]->Update(GSVector4i(0, 0, image.width, image.height),
+                                        image.pixels.data(), image.width * 4)) return false;
+ }
+ delete m_weavebob; delete m_mad;
+ m_weavebob = restored[0].release(); m_mad = restored[1].release();
+ m_deinterlace_index = history.index;
+ return true;
+}
