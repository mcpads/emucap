+			ToResultVector(ret_buffer, slot, ret_cnt);
+			ret_cnt += 4;
+			ToResultVector(ret_buffer, static_cast<u32>(EmuConfig.Mcd[slot].Enabled), ret_cnt);
+			ret_cnt += 4;
+			ToResultVector(ret_buffer, static_cast<u32>(FileMcd_IsPresent(slot, 0) != 0), ret_cnt);
+			ret_cnt += 4;
+			ToResultVector(ret_buffer, static_cast<u32>(EmuConfig.Mcd[slot].Type), ret_cnt);
+			ret_cnt += 4;
+			ToResultVector(ret_buffer, static_cast<u32>(mcds[slot][0].autoEjectTicks), ret_cnt);
+			ret_cnt += 4;
+			ToResultVector(ret_buffer, static_cast<u32>(filename.size()), ret_cnt);
+			ret_cnt += 4;
+			if (!filename.empty())
+			{
+				memcpy(&ret_buffer[ret_cnt], filename.data(), filename.size());
+				ret_cnt += static_cast<u32>(filename.size());
+			}
+		}
+		return true;
+	}
