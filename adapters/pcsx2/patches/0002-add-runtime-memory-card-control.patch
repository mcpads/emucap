+	static bool IsEmuCapMemoryCardName(const std::string& name)
+	{
+		return !name.empty() && name.size() <= 255 && name != "." && name != ".." &&
+			name.find('/') == std::string::npos && name.find('\\') == std::string::npos &&
+			Path::GetFileName(name) == name && StringUtil::EndsWithNoCase(name, ".ps2");
+	}
+
+	static bool HasEmuCapMemoryCardTransition()
+	{
+		for (u32 port = 0; port < 2; port++)
+		{
+			if (mcds[port][0].autoEjectTicks > 0)
+				return true;
+		}
+		return false;
+	}
+
+	static bool EmuCapMemoryCardMatches(u32 slot, bool mounted, const std::string& filename)
+	{
+		if (slot >= 2)
+			return false;
+		const bool present = FileMcd_IsPresent(slot, 0) != 0;
+		if (!mounted)
+			return EmuConfig.Mcd[slot].Filename.empty() && !present;
+		return EmuConfig.Mcd[slot].Enabled && EmuConfig.Mcd[slot].Type == MemoryCardType::File &&
+			EmuConfig.Mcd[slot].Filename == filename && present;
+	}
+
+	static void ApplyEmuCapMemoryCardSetting(u32 slot, bool enabled, const std::string& filename)
+	{
+		const std::string enable_key = fmt::format("Slot{}_Enable", slot + 1);
+		const std::string filename_key = fmt::format("Slot{}_Filename", slot + 1);
+		Host::SetBaseBoolSettingValue("MemoryCards", enable_key.c_str(), enabled);
+		Host::SetBaseStringSettingValue("MemoryCards", filename_key.c_str(), filename.c_str());
+		Host::CommitBaseSettingChanges();
+		VMManager::ApplySettings();
+
+		// Applying memory-card settings reopens every card and may arm auto-eject on sibling
+		// slots. The emucap operation owns one main slot, so discard those incidental
+		// transitions and retain only the requested insertion delay.
+		AutoEject::ClearAll();
+		if (enabled && !filename.empty())
+			AutoEject::Set(slot, 0);
+	}
+
+	static EmuCapMemoryCardChangeResult ChangeEmuCapMemoryCard(
+		u32 slot, bool mount, const std::string& filename)
+	{
+		if (slot >= 2)
+			return EmuCapMemoryCardChangeResult::InvalidSlot;
+		if (MemcardBusy::IsBusy() || HasEmuCapMemoryCardTransition())
+			return EmuCapMemoryCardChangeResult::Busy;
+		if (mount)
+		{
+			if (!IsEmuCapMemoryCardName(filename))
+				return EmuCapMemoryCardChangeResult::InvalidName;
+			const std::optional<AvailableMcdInfo> card = FileMcd_GetCardInfo(filename);
+			if (!card || card->type != MemoryCardType::File ||
+				card->file_type <= MemoryCardFileType::Unknown ||
+				card->file_type >= MemoryCardFileType::PS1)
+			{
+				return EmuCapMemoryCardChangeResult::InvalidCard;
+			}
+		}
+		else if (!filename.empty())
+		{
+			return EmuCapMemoryCardChangeResult::InvalidName;
+		}
+
+		const Pcsx2Config::McdOptions previous = EmuConfig.Mcd[slot];
+		const bool previous_present = FileMcd_IsPresent(slot, 0) != 0;
+		ApplyEmuCapMemoryCardSetting(slot, mount || previous.Enabled, mount ? filename : std::string());
+		if (EmuCapMemoryCardMatches(slot, mount, filename))
+			return EmuCapMemoryCardChangeResult::Completed;
+
+		ApplyEmuCapMemoryCardSetting(slot, previous.Enabled, previous.Filename);
+		const bool restored = EmuConfig.Mcd[slot].Enabled == previous.Enabled &&
+			EmuConfig.Mcd[slot].Filename == previous.Filename &&
+			(FileMcd_IsPresent(slot, 0) != 0) == previous_present;
+		return restored ? EmuCapMemoryCardChangeResult::FailedRolledBack :
+			EmuCapMemoryCardChangeResult::FailedRollbackFailed;
+	}
