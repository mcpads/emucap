+	static bool WriteEmuCapMemoryCardStatus(std::vector<u8>& ret_buffer, u32& ret_cnt)
+	{
+		constexpr u32 slot_count = 2;
+		u32 required = 8;
+		for (u32 slot = 0; slot < slot_count; slot++)
+		{
+			if (EmuConfig.Mcd[slot].Filename.size() > 255)
+				return false;
+			required += 24 + static_cast<u32>(EmuConfig.Mcd[slot].Filename.size());
+		}
+		if (ret_cnt + required >= MAX_IPC_RETURN_SIZE)
+			return false;
