+
+bool VMManager::SetEmucapSpeedPercent(u32 percent)
+{
+	if (percent > 10000)
+		return false;
+	if (percent == 0)
+	{
+		SetLimiterMode(LimiterModeType::Unlimited);
+		return true;
+	}
+	s_emucap_nominal_speed = static_cast<float>(percent) / 100.0f;
+	if (s_limiter_mode == LimiterModeType::Nominal)
+		UpdateTargetSpeed();
+	else
+		SetLimiterMode(LimiterModeType::Nominal);
+	return true;
+}
