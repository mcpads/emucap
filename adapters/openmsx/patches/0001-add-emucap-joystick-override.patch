 uint8_t JoystickPort::read(EmuTime time)
 {
-	return getPluggedJoyDev().read(time);
+	return emucapOverrideEngaged
+	     ? emucapOverrideMask
+	     : getPluggedJoyDev().read(time);
+}
+
+void JoystickPort::setEmucapOverride(uint8_t mask)
+{
+	assert(mask <= 0x3f);
+	emucapOverrideMask = mask;
+	emucapOverrideEngaged = true;
+}
+
+void JoystickPort::clearEmucapOverride()
+{
+	emucapOverrideMask = 0x3f;
+	emucapOverrideEngaged = false;
 }
 
