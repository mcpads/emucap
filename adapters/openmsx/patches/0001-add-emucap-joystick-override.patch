+// class EmucapJoyOverrideDebuggable
+
+EmucapJoyOverrideDebuggable::EmucapJoyOverrideDebuggable(
+		MSXMotherBoard& motherBoard_)
+	: SimpleDebuggable(
+		motherBoard_, "emucap_joystick_override",
+		"emucap joystick input ownership", 2)
+{
+}
+
+uint8_t EmucapJoyOverrideDebuggable::read(unsigned address, EmuTime /*time*/)
+{
+	auto* port = dynamic_cast<JoystickPort*>(
+		&getMotherBoard().getJoystickPort(address));
+	if (!port || !port->isEmucapOverrideEngaged()) return 0;
+	return uint8_t(0x80 | port->getEmucapOverrideMask());
+}
+
+void EmucapJoyOverrideDebuggable::write(unsigned address, uint8_t value)
+{
+	auto* port = dynamic_cast<JoystickPort*>(
+		&getMotherBoard().getJoystickPort(address));
+	if (!port) {
+		throw CommandException(
+			"Joystick port ", address + 1, " is not available.");
+	}
+	if (value == 0xff) {
+		port->clearEmucapOverride();
+	} else if (value <= 0x3f) {
+		port->setEmucapOverride(value);
+	} else {
+		throw CommandException(
+			"emucap joystick override must be 0x00..0x3f or 0xff.");
+	}
+}
+
