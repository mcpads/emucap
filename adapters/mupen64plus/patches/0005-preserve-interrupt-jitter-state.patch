--- /dev/null
+++ b/src/device/r4300/interrupt_jitter.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef M64P_INTERRUPT_JITTER_H
+#define M64P_INTERRUPT_JITTER_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+/* Instance-owned xorshift32; zero is excluded from the state domain. */
+static inline uint32_t interrupt_jitter_next(uint32_t *state, int enabled)
+{
+    if (!enabled) return 0;
+    uint32_t x = *state;
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    *state = x;
+    return x & 63;
+}
+
+/* Last 32 bytes of the native 4096-byte extension, previously zero padding.
+ * ECJITTER + LE32 encoding + LE32 state + LE32 complement + zero reserved. */
+#define INTERRUPT_JITTER_RECORD_SIZE 32
+static inline uint32_t interrupt_jitter_read32(const unsigned char *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24;
+}
+static inline void interrupt_jitter_write32(unsigned char *p, uint32_t x)
+{
+    for (unsigned i = 0; i < 4; ++i) p[i] = (unsigned char)(x >> (8*i));
+}
+/* 0 = legacy padding; 1 = admitted record; -1 = malformed or unknown.
+ * Failure and legacy records leave the caller's live state untouched. */
+static inline int interrupt_jitter_decode(const unsigned char *p, size_t size, uint32_t *state)
+{
+    if (size != INTERRUPT_JITTER_RECORD_SIZE) return -1;
+    unsigned nonzero = 0;
+    for (size_t i = 0; i < size; ++i) nonzero |= p[i];
+    if (!nonzero) return 0;
+    if (memcmp(p, "ECJITTER", 8) || interrupt_jitter_read32(p+8) != 1) return -1;
+    uint32_t x = interrupt_jitter_read32(p+12);
+    if (!x || interrupt_jitter_read32(p+16) != ~x) return -1;
+    for (size_t i = 20; i < size; ++i) if (p[i]) return -1;
+    *state = x;
+    return 1;
+}
+static inline int interrupt_jitter_encode(unsigned char *p, size_t size, uint32_t state)
+{
+    if (size != INTERRUPT_JITTER_RECORD_SIZE || !state) return 0;
+    memset(p, 0, size);
+    memcpy(p, "ECJITTER", 8);
+    interrupt_jitter_write32(p+8, 1);
+    interrupt_jitter_write32(p+12, state);
+    interrupt_jitter_write32(p+16, ~state);
+    return 1;
+}
+#endif
