+/* The frontend must hold a frozen producer boundary while preparing a load. */
+int savestates_prepare_load(const char *path)
+{
+    if (job != savestates_job_nothing || prepared_load) return M64ERR_INVALID_STATE;
+    if (!path) return M64ERR_UNSUPPORTED; /* Preserve native slot loading. */
+    savestates_type detected = savestates_detect_type((char *)path);
+    if (detected == savestates_type_pj64_zip || detected == savestates_type_pj64_unc)
+        return M64ERR_UNSUPPORTED; /* Existing legacy import path. */
+    if (detected != savestates_type_m64p) return M64ERR_INPUT_INVALID;
+    struct prepared_native_state *snapshot = read_native_state((char *)path);
+    if (!snapshot) return M64ERR_INPUT_INVALID;
+    savestates_set_job(savestates_job_load, savestates_type_m64p, path);
+    if (!fname) {
+        free(snapshot->data);
+        free(snapshot);
+        savestates_clear_job();
+        return M64ERR_NO_MEMORY;
+    }
+    prepared_load = snapshot;
+    return M64ERR_SUCCESS;
+}
