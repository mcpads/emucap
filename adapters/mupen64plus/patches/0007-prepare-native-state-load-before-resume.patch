+static int savestates_load_m64p(struct device* dev, char *filepath)
+{
+    struct prepared_native_state *snapshot = prepared_load;
+    prepared_load = NULL;
+    if (!snapshot) snapshot = read_native_state(filepath);
+    if (!snapshot) return 0;
+    unsigned int version = snapshot->version;
+    unsigned char *savestateData = snapshot->data, *curr = snapshot->data;
+    char queue[1024];
+    unsigned char using_tlb_data[4], data_0001_0200[4096];
+    memcpy(queue, snapshot->queue, sizeof(queue));
+    memcpy(using_tlb_data, snapshot->using_tlb, sizeof(using_tlb_data));
+    memcpy(data_0001_0200, snapshot->extra, sizeof(data_0001_0200));
+    uint32_t restored_jitter = snapshot->has_jitter ? snapshot->jitter : dev->r4300.interrupt_jitter_state;
+    free(snapshot);
+    int i;
+    uint32_t FCR31;
+    uint32_t* cp0_regs = r4300_cp0_regs(&dev->r4300.cp0);
 
