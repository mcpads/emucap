+/* Native owner: every policy writer and scheduling reader participates here. */
+static SDL_mutex* l_PacingMutex;
+static m64p_emucap_policy l_Pacing = {100, 1, 0, 0, 0, 0, 1};
+static int l_SavedSpeedFactor = 100;
+/* These mirrors are emulation-thread-only, never part of the policy owner. */
+static int l_AudioSpeedFactor = -1;
+static int l_FastForwardShown = 0;
+
+int main_pacing_init(void)
+{
+    l_PacingMutex = SDL_CreateMutex();
+    if (!l_PacingMutex) return 0;
+    l_Pacing = (m64p_emucap_policy){100, 1, 0, 0, 0, 0, 1};
+    l_SavedSpeedFactor = 100;
+    l_AudioSpeedFactor = -1;
+    l_FastForwardShown = 0;
+    return 1;
+}
+
+void main_pacing_shutdown(void)
+{
+    SDL_DestroyMutex(l_PacingMutex);
+    l_PacingMutex = NULL;
+}
+
+m64p_emucap_policy main_pacing_read(void)
+{
+    SDL_LockMutex(l_PacingMutex);
+    m64p_emucap_policy policy = l_Pacing;
+    SDL_UnlockMutex(l_PacingMutex);
+    return policy;
+}
+
+static void pacing_advance(const m64p_emucap_policy* previous)
+{
+    if (previous->factor != l_Pacing.factor || previous->limiter != l_Pacing.limiter ||
+        previous->fast_forward != l_Pacing.fast_forward || previous->netplay != l_Pacing.netplay ||
+        previous->netplay_lag != l_Pacing.netplay_lag)
+        ++l_Pacing.revision;
+}
+
+void main_pacing_set_netplay(int active)
+{
+    SDL_LockMutex(l_PacingMutex);
+    m64p_emucap_policy previous = l_Pacing;
+    l_Pacing.netplay = !!active;
+    pacing_advance(&previous);
+    SDL_UnlockMutex(l_PacingMutex);
+}
+
+void main_pacing_set_netplay_lag(int lag)
+{
+    SDL_LockMutex(l_PacingMutex);
+    m64p_emucap_policy previous = l_Pacing;
+    l_Pacing.netplay_lag = !!lag;
+    pacing_advance(&previous);
+    SDL_UnlockMutex(l_PacingMutex);
+}
+
+/* The netplay worker's lag decision and limiter update form one publication. */
+void main_pacing_netplay_limiter(int lag)
+{
+    SDL_LockMutex(l_PacingMutex);
+    m64p_emucap_policy previous = l_Pacing;
+    l_Pacing.netplay_lag = !!lag;
+    l_Pacing.limiter = !lag;
+    pacing_advance(&previous);
+    SDL_UnlockMutex(l_PacingMutex);
+}
+
+m64p_error main_pacing_transaction(uint32_t operation, int32_t percent,
+                                 m64p_emucap_pacing_result* result)
+{
+    if (operation > 1 || percent < 0 || percent > 1000)
+        return M64ERR_INPUT_INVALID;
+    SDL_LockMutex(l_PacingMutex);
+    result->version = 1;
+    result->outcome = 0;
+    result->previous = l_Pacing;
+    if (operation == 1) {
+        if (l_Pacing.netplay) result->outcome = 1;
+        else {
+            /* Cancel saved hotkey state: its later key release must not undo this change. */
+            if (l_Pacing.fast_forward) l_Pacing.factor = l_SavedSpeedFactor;
+            l_Pacing.fast_forward = 0;
+            if (percent) l_Pacing.factor = percent;
+            l_Pacing.limiter = percent != 0;
+            pacing_advance(&result->previous);
+        }
+    }
+    result->applied = l_Pacing;
+    SDL_UnlockMutex(l_PacingMutex);
+    /* immutable event; reentrant observers may publish a later transition */
+    if (result->previous.factor != result->applied.factor)
+        StateChanged(M64CORE_SPEED_FACTOR, result->applied.factor);
+    return M64ERR_SUCCESS;
+}
+
+static void main_speed_adjust(int percent)
+{
+    SDL_LockMutex(l_PacingMutex);
+    m64p_emucap_policy previous = l_Pacing;
+    int64_t next = (int64_t)l_Pacing.factor + percent;
+    if (!l_Pacing.netplay && (percent < 0 ? next > 10 : next < 300)) l_Pacing.factor = (int)next;
+    pacing_advance(&previous);
+    m64p_emucap_policy applied = l_Pacing;
+    SDL_UnlockMutex(l_PacingMutex);
+    if (applied.factor != previous.factor) {
+        main_message(M64MSG_STATUS, OSD_BOTTOM_LEFT, "Playback speed: %d%%", applied.factor);
+        StateChanged(M64CORE_SPEED_FACTOR, applied.factor);
+    }
+}
+
+void main_speeddown(int percent) { if (percent > 0) main_speed_adjust(-percent); }
+void main_speedup(int percent) { if (percent > 0) main_speed_adjust(percent); }
 
