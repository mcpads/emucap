+/* Versioned host pacing snapshots. All fields have fixed-width ABI types. */
+#ifndef M64P_EMUCAP_PACING_H
+#define M64P_EMUCAP_PACING_H
+#include <stdint.h>
+typedef struct {
+    int32_t factor, limiter, fast_forward, netplay, netplay_lag;
+    uint32_t reserved;
+    uint64_t revision;
+} m64p_emucap_policy;
+typedef struct {
+    uint32_t version, outcome; /* 0 completed, 1 unchanged native rejection */
+    m64p_emucap_policy previous, applied;
+} m64p_emucap_pacing_result;
+#endif
