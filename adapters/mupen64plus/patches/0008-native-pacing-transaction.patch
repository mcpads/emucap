+/* ABI admission precedes every read or mutation. */
+EXPORT m64p_error CALL CoreEmucapPacing(uint32_t version, uint32_t operation, int32_t percent,
+                                      m64p_emucap_pacing_result* result, uint32_t result_size)
+{
+    if (!l_CoreInit) return M64ERR_NOT_INIT;
+    if (version != 1) return M64ERR_INCOMPATIBLE;
+    if (!result || result_size != sizeof(*result)) return M64ERR_INPUT_INVALID;
+    return main_pacing_transaction(operation, percent, result);
+}
