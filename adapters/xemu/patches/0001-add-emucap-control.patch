index ace02bc..fcc4a7f 100644
--- i/ui/xui/main.cc
+++ w/ui/xui/main.cc
@@ -31,6 +31,8 @@
 #include <string>
 #include <memory>
 
+#include <glib/gstdio.h>
+
 #include "actions.hh"
 #include "common.hh"
 #include "xemu-hud.h"
@@ -50,6 +52,7 @@
 #include "welcome.hh"
 #include "menubar.hh"
 #include "compat.hh"
+#include "ui/xemu-emucap.h"
 #if defined(_WIN32)
 #include "update.hh"
 #endif
@@ -65,6 +68,70 @@ static int g_vsync;
 static GLuint g_tex;
 static bool g_flip_req;
 
+static void RenderEmucapScreenshot()
+{
+    uint64_t request_id;
+    if (!xemu_emucap_take_screenshot_request(&request_id)) {
+        return;
+    }
+
+    std::vector<uint8_t> png;
+    if (!RenderFramebufferToPng(g_tex, g_flip_req, png)) {
+        xemu_emucap_complete_screenshot(request_id, nullptr,
+                                        "failed to encode PNG image");
+        return;
+    }
+
+    const char *screen_root = g_getenv("EMUCAP_XEMU_SCREEN_ROOT");
+    if (!screen_root || !g_path_is_absolute(screen_root)) {
+        xemu_emucap_complete_screenshot(request_id, nullptr,
+                                        "EMUCAP_XEMU_SCREEN_ROOT must be an absolute path");
+        return;
+    }
+
+    char *directory = g_strdup(screen_root);
+    if (g_mkdir_with_parents(directory, 0700) != 0) {
+        char *message = g_strdup_printf("failed to create screenshot directory: %s",
+                                        g_strerror(errno));
+        xemu_emucap_complete_screenshot(request_id, nullptr, message);
+        g_free(message);
+        g_free(directory);
+        return;
+    }
+
+    char *filename = g_strdup_printf("emucap-%020" G_GUINT64_FORMAT ".png",
+                                     static_cast<guint64>(request_id));
+    char *temporary = g_strdup_printf(".%s.tmp", filename);
+    char *path = g_build_filename(directory, filename, nullptr);
+    char *temporary_path = g_build_filename(directory, temporary, nullptr);
+    GError *error = nullptr;
+
+    bool written = g_file_set_contents(temporary_path,
+                                       reinterpret_cast<const char *>(png.data()),
+                                       png.size(), &error);
+    if (written && g_rename(temporary_path, path) != 0) {
+        g_set_error(&error, G_FILE_ERROR, g_file_error_from_errno(errno),
+                    "failed to publish screenshot: %s", g_strerror(errno));
+        written = false;
+    }
