diff --git i/ui/xemu-emucap.c w/ui/xemu-emucap.c
new file mode 100644
index 0000000..ab47e0f
--- /dev/null
+++ w/ui/xemu-emucap.c
@@ -0,0 +1,262 @@
+/*
+ * xemu emucap control extension
+ *
+ * Copyright (C) 2026 emucap contributors
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-xemu-emucap.h"
+#include "system/runstate.h"
+#include "xemu-emucap.h"
+#include "xemu-input.h"
+#include "xui/xemu-hud.h"
+
+#define XEMU_EMUCAP_API 1
+#define XEMU_EMUCAP_MAX_FRAME_STEP 5000
+
+typedef struct XemuEmucapInput {
+    bool engaged;
+    uint16_t buttons;
+    int16_t axes[CONTROLLER_AXIS__COUNT];
+} XemuEmucapInput;
+
+typedef enum XemuEmucapScreenshotResult {
+    XEMU_EMUCAP_SCREENSHOT_IDLE,
+    XEMU_EMUCAP_SCREENSHOT_PENDING,
+    XEMU_EMUCAP_SCREENSHOT_COMPLETED,
+    XEMU_EMUCAP_SCREENSHOT_FAILED,
+} XemuEmucapScreenshotResult;
+
+typedef struct XemuEmucapScreenshot {
+    uint64_t request_id;
+    XemuEmucapScreenshotResult state;
+    bool rendering;
+    char *filename;
+    char *message;
+} XemuEmucapScreenshot;
+
+static XemuEmucapInput input;
+static uint64_t frame_boundary;
+static bool frame_step_active;
+static uint32_t frame_step_remaining;
+static XemuEmucapScreenshot screenshot;
+G_LOCK_DEFINE_STATIC(xemu_emucap);
+
+XemuEmucapStatus *qmp_xemu_emucap_status(Error **errp)
+{
+    XemuEmucapStatus *status = g_new0(XemuEmucapStatus, 1);
+
+    G_LOCK(xemu_emucap);
+    status->api = XEMU_EMUCAP_API;
+    status->frame_boundary = frame_boundary;
+    status->frame_step_active = frame_step_active;
+    status->frame_step_remaining = frame_step_remaining;
+    status->input_engaged = input.engaged;
+    G_UNLOCK(xemu_emucap);
+    return status;
+}
+
+void qmp_xemu_emucap_set_input(bool engaged, uint16_t buttons,
+                               int16_t ltrigger, int16_t rtrigger,
+                               int16_t lstick_x, int16_t lstick_y,
+                               int16_t rstick_x, int16_t rstick_y,
+                               Error **errp)
+{
+    if (engaged && xemu_input_get_bound(0) == NULL) {
+        error_setg(errp, "emucap input requires a controller bound to port 1");
+        return;
+    }
+
+    G_LOCK(xemu_emucap);
+    input.buttons = buttons;
+    input.axes[CONTROLLER_AXIS_LTRIG] = ltrigger;
+    input.axes[CONTROLLER_AXIS_RTRIG] = rtrigger;
+    input.axes[CONTROLLER_AXIS_LSTICK_X] = lstick_x;
+    input.axes[CONTROLLER_AXIS_LSTICK_Y] = lstick_y;
+    input.axes[CONTROLLER_AXIS_RSTICK_X] = rstick_x;
+    input.axes[CONTROLLER_AXIS_RSTICK_Y] = rstick_y;
+    input.engaged = engaged;
+    G_UNLOCK(xemu_emucap);
+}
+
+void qmp_xemu_emucap_arm_frame_step(uint32_t count, Error **errp)
+{
+    if (count == 0 || count > XEMU_EMUCAP_MAX_FRAME_STEP) {
+        error_setg(errp, "frame step count must be in 1..%u",
+                   XEMU_EMUCAP_MAX_FRAME_STEP);
+        return;
+    }
+    if (runstate_is_running()) {
+        error_setg(errp, "frame step can only be armed while the VM is stopped");
+        return;
+    }
+    G_LOCK(xemu_emucap);
+    if (frame_step_active) {
+        G_UNLOCK(xemu_emucap);
+        error_setg(errp, "a frame step is already armed");
+        return;
+    }
+
+    frame_step_remaining = count;
+    frame_step_active = true;
+    G_UNLOCK(xemu_emucap);
+}
+
+void qmp_xemu_emucap_cancel_frame_step(Error **errp)
+{
+    G_LOCK(xemu_emucap);
+    frame_step_active = false;
+    frame_step_remaining = 0;
+    G_UNLOCK(xemu_emucap);
+}
+
+void xemu_emucap_apply_input(ControllerState *state)
+{
+    if (state != bound_controllers[0]) {
+        return;
+    }
+
+    G_LOCK(xemu_emucap);
+    if (input.engaged) {
+        state->buttons = input.buttons;
+        memcpy(state->axis, input.axes, sizeof(input.axes));
+    }
+    G_UNLOCK(xemu_emucap);
+}
+
+void xemu_emucap_frame_boundary(void)
+{
+    bool should_stop = false;
+
+    if (!runstate_is_running()) {
+        return;
+    }
+
+    G_LOCK(xemu_emucap);
+    frame_boundary++;
+    if (frame_step_active) {
+        assert(frame_step_remaining > 0);
+        frame_step_remaining--;
+        if (frame_step_remaining == 0) {
+            frame_step_active = false;
+            should_stop = true;
+        }
+    }
+    G_UNLOCK(xemu_emucap);
+
+    if (should_stop) {
+        vm_stop(RUN_STATE_PAUSED);
+    }
+}
+
+void qmp_xemu_emucap_request_screenshot(uint64_t request_id, Error **errp)
+{
+    if (request_id == 0) {
+        error_setg(errp, "screenshot request id must be nonzero");
+        return;
+    }
+
+    G_LOCK(xemu_emucap);
+    if (screenshot.state == XEMU_EMUCAP_SCREENSHOT_PENDING) {
+        G_UNLOCK(xemu_emucap);
+        error_setg(errp, "a screenshot request is already pending");
+        return;
+    }
+
+    g_clear_pointer(&screenshot.filename, g_free);
+    g_clear_pointer(&screenshot.message, g_free);
+    screenshot.request_id = request_id;
+    screenshot.state = XEMU_EMUCAP_SCREENSHOT_PENDING;
+    screenshot.rendering = false;
+    G_UNLOCK(xemu_emucap);
+}
+
+XemuEmucapScreenshotStatus *qmp_xemu_emucap_screenshot_status(
+    uint64_t request_id, Error **errp)
+{
+    XemuEmucapScreenshotStatus *status;
+
+    G_LOCK(xemu_emucap);
+    if (screenshot.state == XEMU_EMUCAP_SCREENSHOT_IDLE ||
+        screenshot.request_id != request_id) {
+        G_UNLOCK(xemu_emucap);
+        error_setg(errp, "unknown screenshot request id");
+        return NULL;
+    }
+
+    status = g_new0(XemuEmucapScreenshotStatus, 1);
+    status->request_id = request_id;
+    switch (screenshot.state) {
+    case XEMU_EMUCAP_SCREENSHOT_IDLE:
+        status->state = XEMU_EMUCAP_SCREENSHOT_STATE_IDLE;
+        break;
+    case XEMU_EMUCAP_SCREENSHOT_PENDING:
+        status->state = XEMU_EMUCAP_SCREENSHOT_STATE_PENDING;
+        break;
+    case XEMU_EMUCAP_SCREENSHOT_COMPLETED:
+        status->state = XEMU_EMUCAP_SCREENSHOT_STATE_COMPLETED;
+        break;
+    case XEMU_EMUCAP_SCREENSHOT_FAILED:
+        status->state = XEMU_EMUCAP_SCREENSHOT_STATE_FAILED;
+        break;
+    }
+    if (screenshot.filename) {
+        status->filename = g_strdup(screenshot.filename);
+    }
+    if (screenshot.message) {
+        status->message = g_strdup(screenshot.message);
+    }
+    G_UNLOCK(xemu_emucap);
+    return status;
+}
+
+bool xemu_emucap_take_screenshot_request(uint64_t *request_id)
+{
+    bool take = false;
+
+    G_LOCK(xemu_emucap);
+    if (screenshot.state == XEMU_EMUCAP_SCREENSHOT_PENDING &&
+        !screenshot.rendering) {
+        screenshot.rendering = true;
+        *request_id = screenshot.request_id;
+        take = true;
+    }
+    G_UNLOCK(xemu_emucap);
+    return take;
+}
+
+void xemu_emucap_complete_screenshot(uint64_t request_id,
+                                     const char *filename,
+                                     const char *message)
+{
+    G_LOCK(xemu_emucap);
+    if (screenshot.state == XEMU_EMUCAP_SCREENSHOT_PENDING &&
+        screenshot.request_id == request_id && screenshot.rendering) {
+        screenshot.rendering = false;
+        if (filename) {
+            screenshot.filename = g_strdup(filename);
+            screenshot.state = XEMU_EMUCAP_SCREENSHOT_COMPLETED;
+        } else {
+            screenshot.message = g_strdup(message ? message :
+                                          "screenshot failed");
+            screenshot.state = XEMU_EMUCAP_SCREENSHOT_FAILED;
+        }
+    }
+    G_UNLOCK(xemu_emucap);
+}
+
+void qmp_xemu_emucap_eject_disc(Error **errp)
+{
+    xemu_eject_disc(errp);
+}
+
+void qmp_xemu_emucap_load_disc(const char *path, Error **errp)
+{
+    xemu_load_disc(path, errp);
+}
