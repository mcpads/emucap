diff --git i/qapi/xemu-emucap.json w/qapi/xemu-emucap.json
new file mode 100644
index 0000000..2420524
--- /dev/null
+++ w/qapi/xemu-emucap.json
@@ -0,0 +1,155 @@
+# -*- Mode: Python -*-
+# vim: filetype=python
+
+##
+# = xemu emucap control
+##
+
+##
+# @XemuEmucapStatus:
+#
+# @api: host extension API revision
+#
+# @frame-boundary: running-only NV2A frame boundary counter
+#
+# @frame-step-active: whether a bounded frame stop is armed
+#
+# @frame-step-remaining: boundaries remaining before the armed stop
+#
+# @input-engaged: whether port-zero emucap input owns the
+#     guest-visible state
+##
+{ 'struct': 'XemuEmucapStatus',
+  'data': { 'api': 'uint32',
+            'frame-boundary': 'uint64',
+            'frame-step-active': 'bool',
+            'frame-step-remaining': 'uint32',
+            'input-engaged': 'bool' } }
+
+##
+# @xemu-emucap-status:
+#
+# Return the live state of the xemu extension.
+##
+{ 'command': 'xemu-emucap-status',
+  'returns': 'XemuEmucapStatus' }
+
+##
+# @xemu-emucap-set-input:
+#
+# Replace or release the guest-visible controller state for port zero.
+#
+# @engaged: whether emucap owns the guest-visible state
+#
+# @buttons: Xbox digital-button bit mask
+#
+# @ltrigger: left-trigger value
+#
+# @rtrigger: right-trigger value
+#
+# @lstick-x: left-stick horizontal value
+#
+# @lstick-y: left-stick vertical value
+#
+# @rstick-x: right-stick horizontal value
+#
+# @rstick-y: right-stick vertical value
+##
+{ 'command': 'xemu-emucap-set-input',
+  'data': { 'engaged': 'bool',
+            'buttons': 'uint16',
+            'ltrigger': 'int16',
+            'rtrigger': 'int16',
+            'lstick-x': 'int16',
+            'lstick-y': 'int16',
+            'rstick-x': 'int16',
+            'rstick-y': 'int16' } }
+
+##
+# @xemu-emucap-arm-frame-step:
+#
+# Arm a stop after @count running NV2A frame boundaries.  The VM
+# must be stopped.  Continuing execution remains the debugger
+# client's responsibility.
+#
+# @count: number of running frame boundaries before the stop
+##
+{ 'command': 'xemu-emucap-arm-frame-step',
+  'data': { 'count': 'uint32' } }
+
+##
+# @xemu-emucap-cancel-frame-step:
+#
+# Cancel an armed frame stop without changing run state.
+##
+{ 'command': 'xemu-emucap-cancel-frame-step' }
+
+##
+# @XemuEmucapScreenshotState:
+#
+# @idle: no screenshot has been requested
+#
+# @pending: a screenshot is waiting for the display thread
+#
+# @completed: the screenshot was written successfully
+#
+# @failed: the screenshot could not be captured or written
+##
+{ 'enum': 'XemuEmucapScreenshotState',
+  'data': [ 'idle', 'pending', 'completed', 'failed' ] }
+
+##
+# @XemuEmucapScreenshotStatus:
+#
+# @request-id: caller-generated request identity
+#
+# @state: current request state
+#
+# @filename: generated basename under the managed screenshot directory
+#
+# @message: failure detail
+##
+{ 'struct': 'XemuEmucapScreenshotStatus',
+  'data': { 'request-id': 'uint64',
+            'state': 'XemuEmucapScreenshotState',
+            '*filename': 'str',
+            '*message': 'str' } }
+
+##
+# @xemu-emucap-request-screenshot:
+#
+# Queue a framebuffer capture for the display thread.
+# Output goes under the managed settings directory.
+#
+# @request-id: nonzero caller-generated request identity
+##
+{ 'command': 'xemu-emucap-request-screenshot',
+  'data': { 'request-id': 'uint64' } }
+
+##
+# @xemu-emucap-screenshot-status:
+#
+# Return the state of one screenshot request.
+#
+# @request-id: identity passed to @xemu-emucap-request-screenshot
+##
+{ 'command': 'xemu-emucap-screenshot-status',
+  'data': { 'request-id': 'uint64' },
+  'returns': 'XemuEmucapScreenshotStatus' }
+
+##
+# @xemu-emucap-eject-disc:
+#
+# Open the emulated Xbox DVD tray and remove the current disc.
+##
+{ 'command': 'xemu-emucap-eject-disc' }
+
+##
+# @xemu-emucap-load-disc:
+#
+# Open the emulated Xbox DVD tray and load a raw XISO image.
+#
+# @path: host path of the replacement disc image
+##
+{ 'command': 'xemu-emucap-load-disc',
+  'data': { 'path': 'str' } }
