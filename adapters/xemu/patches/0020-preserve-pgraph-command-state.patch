+/* VMState skips post_load on field/subsection errors. Own the lock around
+ * the entire decoder so truncation and malformed input cannot strand the FIFO. */
+static int nv2a_payload_get(QEMUFile *f, void *pv, size_t size,
+                            const VMStateField *field)
+{
+    NV2AState *d = pv;
+    Error *err = NULL;
+    nv2a_pre_load(d);
+    int ret = vmstate_load_state(f, &vmstate_nv2a_payload, d, 4, &err);
+    nv2a_unlock_fifo(d);
+    if (err) {
+        qemu_file_set_error_obj(f, ret < 0 ? ret : -EINVAL, err);
+    }
+    return ret;
+}
+
+static int nv2a_payload_put(QEMUFile *f, void *pv, size_t size,
+                            const VMStateField *field, JSONWriter *vmdesc)
+{
+    NV2AState *d = pv;
+    Error *err = NULL;
+    nv2a_pre_save(d);
+    int ret = vmstate_save_state(f, &vmstate_nv2a_payload, d, vmdesc, &err);
+    nv2a_post_save(d);
+    if (err) {
+        qemu_file_set_error_obj(f, ret < 0 ? ret : -EINVAL, err);
+    }
+    return ret;
+}
+
+static const VMStateInfo vmstate_nv2a_payload_info = {
+    .name = "nv2a-payload",
+    .get = nv2a_payload_get,
+    .put = nv2a_payload_put,
+};
