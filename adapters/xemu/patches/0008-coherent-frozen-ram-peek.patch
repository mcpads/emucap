+const uint8_t *nv2a_emucap_begin_ram_read(bool *was_halted)
+{
+    NV2AState *d = g_nv2a;
+
+    /* Materialize existing GPU writes without executing new FIFO commands.
+     * The renderer performs downloads on its own thread/context, exactly as
+     * for save-state coherence. No GPU lock is held while waiting for it. */
+    nv2a_lock_fifo(d);
+    *was_halted = qatomic_read(&d->pfifo.halt);
+    qatomic_set(&d->pfifo.halt, true);
+    pgraph_pre_savevm_trigger(d);
+    nv2a_unlock_fifo(d);
+    bql_unlock();
+    pgraph_pre_savevm_wait(d);
+    bql_lock();
+    nv2a_lock_fifo(d);
+    return d->vram_ptr;
+}
+
+void nv2a_emucap_end_ram_read(bool was_halted)
+{
+    qatomic_set(&g_nv2a->pfifo.halt, was_halted);
+    nv2a_unlock_fifo(g_nv2a);
 }
 
