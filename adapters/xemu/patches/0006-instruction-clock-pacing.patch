+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qemu/host-utils.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "exec/icount.h"
+#include "system/cpus.h"
+#include "system/runstate.h"
+#include "xemu-emucap-pacing.h"
+
+/* BQL owns the policy and anchors. Guest time is exclusively owned by icount. */
+static struct {
+    uint32_t percent;
+    uint64_t revision;
+    int64_t host;
+    int64_t guest;
+    QEMUTimer *wake;
+} pacing = { .percent = 100 };
+
+static void anchor(void)
+{
+    pacing.host = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    pacing.guest = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static void vm_changed(void *opaque, bool running, RunState state)
+{
+    if (running) {
+        anchor();
+    }
+}
+
+static void wake(void *opaque)
+{
+    qemu_notify_event();
+    if (first_cpu) {
+        qemu_cpu_kick(first_cpu);
+    }
+}
+
+static void init(void)
+{
+    if (!pacing.wake) {
+        pacing.wake = timer_new_ns(QEMU_CLOCK_REALTIME, wake, NULL);
+        qemu_add_vm_change_state_handler(vm_changed, NULL);
+        anchor();
+    }
+}
+
+static int64_t wait_for(int64_t guest)
+{
+    int64_t host = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    int64_t target;
+    init();
+    if (!pacing.percent) {
+        return 0;
+    }
+    if (guest < pacing.guest) {
+        anchor();
+    }
+    target = pacing.host + muldiv64(guest - pacing.guest, 100, pacing.percent);
+    return MAX(0, target - host);
+}
+
+void xemu_emucap_pacing_wait(CPUState *cpu)
+{
+    int64_t ns;
+    if (!icount_enabled()) {
+        return;
+    }
+    while (cpu_can_run(cpu) && cpu_work_list_empty(cpu) &&
+           (ns = wait_for(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL))) > 0) {
+        qemu_cond_timedwait_bql(cpu->halt_cond,
+                           MAX(1, MIN(10, DIV_ROUND_UP(ns, SCALE_MS))));
+    }
+}
+
+bool xemu_emucap_pacing_warp_ready(int64_t deadline)
+{
+    int64_t ns = wait_for(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + deadline);
+    if (ns <= 0) {
+        return true;
+    }
+    timer_mod_ns(pacing.wake, qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + ns);
+    return false;
+}
+
+bool xemu_emucap_pacing_set(bool unlimited, uint32_t percent, const char **error)
+{
+    uint32_t next = unlimited ? 0 : percent;
+    if (!xemu_emucap_clock_supported()) {
+        *error = "pacing requires the fixed instruction clock";
+        return false;
+    }
+    if (!unlimited && (percent < 1 || percent > 1000)) {
+        *error = "percent must be between 1 and 1000";
+        return false;
+    }
+    init();
+    if (next != pacing.percent) {
+        pacing.revision++;
+        pacing.percent = next;
+    }
+    anchor();
+    timer_del(pacing.wake);
+    wake(NULL);
+    return true;
+}
+
+uint32_t xemu_emucap_pacing_percent(void) { return pacing.percent; }
+uint64_t xemu_emucap_pacing_revision(void) { return pacing.revision; }
