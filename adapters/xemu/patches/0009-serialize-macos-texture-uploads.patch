+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef XEMU_GL_UPLOAD_H
+#define XEMU_GL_UPLOAD_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Leaf barrier for external upload code that does not use the wrapper. */
+void xemu_gl_upload_begin(void);
+void xemu_gl_upload_end(void);
+void xemu_gl_tex_image_2d(unsigned int target, int level, int internal_format,
+                        int width, int height, int border, unsigned int format,
+                        unsigned int type, const void *pixels);
+#ifdef __cplusplus
+}
+#endif
+#endif
--- /dev/null
+++ b/ui/xemu-gl-upload.c
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include <epoxy/gl.h>
+#include "ui/xemu-gl-upload.h"
+
+#ifdef __APPLE__
+/* Leaf lock shared by UI and NV2A contexts. Apple GL pixel-conversion workers
+ * crashed at a null instruction address during overlapping texture uploads.
+ * Keep guest/device locks outside this wrapper and preserve every upload. */
+G_LOCK_DEFINE_STATIC(xemu_gl_upload);
+#endif
+
+void xemu_gl_upload_begin(void)
+{
+#ifdef __APPLE__
+    G_LOCK(xemu_gl_upload);
+#endif
+}
+
+void xemu_gl_upload_end(void)
+{
+#ifdef __APPLE__
+    G_UNLOCK(xemu_gl_upload);
+#endif
+}
+
+void xemu_gl_tex_image_2d(unsigned int target, int level, int internal_format,
+                        int width, int height, int border, unsigned int format,
+                        unsigned int type, const void *pixels)
+{
+    xemu_gl_upload_begin();
+    glTexImage2D(target, level, internal_format, width, height, border,
+                 format, type, pixels);
+    xemu_gl_upload_end();
+}
