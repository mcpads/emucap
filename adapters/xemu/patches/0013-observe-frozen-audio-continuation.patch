+bool mcpx_apu_clock_continuation(MCPXAPUContinuation *out)
+{
+    MCPXAPUState *d = g_state;
+    uint32_t queue[MCPX_HW_MAX_VOICES][2];
+    uint64_t locks[4];
+    uint32_t samples[NUM_SAMPLES_PER_FRAME][2];
+    G_STATIC_ASSERT(sizeof(float) == sizeof(uint32_t));
+
+    if (!d || runstate_is_running()) {
+        return false;
+    }
+    qemu_mutex_lock(&d->lock);
+    VoiceWorkDispatch *work = &d->vp.voice_work_dispatch;
+    if (work->queue_len < 0 || work->queue_len > MCPX_HW_MAX_VOICES) {
+        qemu_mutex_unlock(&d->lock);
+        return false;
+    }
+    out->pending = d->guest_voice_pending;
+    out->queue_length = work->queue_len;
+    out->deadline = d->guest_deadline;
+    out->timer_deadline = d->guest_timer ? timer_expire_time_ns(d->guest_timer) : -1;
+    out->fraction = d->guest_fraction;
+    out->ep_frame_div = d->ep_frame_div;
+    for (int i = 0; i < work->queue_len; i++) {
+        queue[i][0] = cpu_to_be32(work->queue[i].voice);
+        queue[i][1] = cpu_to_be32(work->queue[i].list);
+    }
+    for (int i = 0; i < 4; i++) {
+        locks[i] = cpu_to_be64(d->vp.voice_locked[i]);
+    }
+    for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+        for (int channel = 0; channel < 2; channel++) {
+            uint32_t bits;
+            memcpy(&bits, &d->vp.sample_buf[i][channel], sizeof(bits));
+            samples[i][channel] = cpu_to_be32(bits);
+        }
+    }
+    qemu_mutex_unlock(&d->lock);
+    g_autofree char *queue_hash = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+        (const guchar *)queue, out->queue_length * sizeof(queue[0]));
+    g_autofree char *locks_hash = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+        (const guchar *)locks, sizeof(locks));
+    g_autofree char *samples_hash = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+        (const guchar *)samples, sizeof(samples));
+    g_strlcpy(out->queue_sha256, queue_hash, sizeof(out->queue_sha256));
+    g_strlcpy(out->locks_sha256, locks_hash, sizeof(out->locks_sha256));
+    g_strlcpy(out->samples_sha256, samples_hash, sizeof(out->samples_sha256));
+    return true;
 }
 
