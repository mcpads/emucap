--- /dev/null
+++ b/Utilities/EmucapEnvironment.h
@@ -0,0 +1,19 @@
+#pragma once
+#include <cstdlib>
+#include <memory>
+#include <string>
+
+// Retain an owned value across parsing, including the Windows CRT environment API.
+inline std::string ReadEmucapEnvironment(const char* name)
+{
+#ifdef _WIN32
+	char* value = nullptr;
+	size_t length = 0;
+	const auto error = _dupenv_s(&value, &length, name);
+	std::unique_ptr<char, decltype(&std::free)> owned(value, &std::free);
+	return error == 0 && value ? std::string(value) : std::string();
+#else
+	const char* value = std::getenv(name);
+	return value ? std::string(value) : std::string();
+#endif
+}
