+void Debugger::ServiceAgentControl()
+{
+	// Avoid a host clock read for every guest tick. CPU and PPU paths both
+	// participate, including CPU wait/stop loops serviced by the PPU.
+	if((++_agentServiceTicks & 255) != 0) return;
+	auto now = std::chrono::steady_clock::now();
+	if(now - _agentLastService < std::chrono::milliseconds(10)) return;
+	_agentLastService = now;
+	if(_scriptManager->HasEventCallback(EventType::ControlIdle)) {
+		// On the emulation owner. This event admits control intent, not a
+		// stopped-state or safe-serialization claim.
+		ProcessEvent(EventType::ControlIdle, _mainCpuType);
+	}
+}
+
+AgentControlState Debugger::GetAgentControlState()
+{
+	AgentControlState result;
+	result.Generation = _agentGeneration;
+	result.InstructionBoundaries = _agentInstructionBoundaries;
+	result.HaltedCpuSteps = _agentHaltedCpuSteps;
+	result.PpuCycles = _agentPpuCycles;
+	result.MonotonicMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+	// A scheduled resume clears _waitForBreakResume before this callback
+	// returns. It must immediately revoke the old halt proof.
+	result.Halted = _executionStopped && _waitForBreakResume && !_suspendRequestCount;
+	StepRequest* step = GetMainDebugger()->GetStepRequest();
+	result.InstructionRemaining = step->StepCount;
+	result.PpuRemaining = step->PpuStepCount;
+	result.Type = step->Type;
+	return result;
 }
 
