+int LuaApi::GetControlState(lua_State* lua)
+{
+	LuaCallHelper l(lua);
+	checkparams();
+	checkinitdone();
+	AgentControlState state = _debugger->GetAgentControlState();
+	lua_newtable(lua);
+	lua_pushintvalue(generation, state.Generation);
+	lua_pushintvalue(instructionBoundaries, state.InstructionBoundaries);
+	lua_pushintvalue(haltedCpuSteps, state.HaltedCpuSteps);
+	lua_pushintvalue(ppuCycles, state.PpuCycles);
+	lua_pushintvalue(monotonicMs, state.MonotonicMs);
+	lua_pushintvalue(instructionRemaining, state.InstructionRemaining);
+	lua_pushintvalue(ppuRemaining, state.PpuRemaining);
+	lua_pushintvalue(stepType, (int)state.Type);
+	lua_pushboolvalue(halted, state.Halted);
+	return 1;
 }
 
