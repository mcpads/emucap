+bool GbaPpu::ValidateRasterState(Serializer& s)
+{
+	uint32_t version = 0;
+	uint8_t index = 0xff;
+	return s.TryReadValue("rasterVersion", version) && version == 1
+		&& s.TryReadValue("outputBufferIndex", index) && index < 2
+		&& s.HasValueSize("outputBuffer0", GbaConstants::PixelCount * sizeof(uint16_t))
+		&& s.HasValueSize("outputBuffer1", GbaConstants::PixelCount * sizeof(uint16_t))
+		&& s.HasValueSize("completedFrame", GbaConstants::PixelCount * sizeof(uint16_t))
+		&& s.HasValueSize("previousCompletedFrame", GbaConstants::PixelCount * sizeof(uint16_t));
+}
