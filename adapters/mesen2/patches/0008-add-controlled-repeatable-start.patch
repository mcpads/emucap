-	std::random_device rd;
-	_mt = std::mt19937(rd());
+	const char* fixedSeed = std::getenv("EMUCAP_REPEATABLE_SEED");
+	if(fixedSeed) {
+		char* end = nullptr;
+		errno = 0;
+		unsigned long seed = std::strtoul(fixedSeed, &end, 10);
+		if(errno == 0 && end != fixedSeed && *end == '\0' && seed <= UINT32_MAX) {
+			_mt = std::mt19937((uint32_t)seed);
+		} else {
+			std::random_device rd;
+			_mt = std::mt19937(rd());
+		}
+	} else {
+		std::random_device rd;
+		_mt = std::mt19937(rd());
+	}
