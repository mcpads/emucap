+static uint64_t CurrentUnixTime()
+{
+	const char* fixedTime = std::getenv("EMUCAP_FIXED_UNIX_TIME");
+	if(fixedTime) {
+		char* end = nullptr;
+		errno = 0;
+		unsigned long long value = std::strtoull(fixedTime, &end, 10);
