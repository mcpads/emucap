+void GbPpu::SubmitFrame(RenderedFrame& frame, bool synchronous, bool rewinding)
+{
+	GbPpu* owner = _gameboy->IsPrimaryConsole() ? this : _gameboy->GetLinkedConsole()->GetPpu();
+	_emu->GetVideoDecoder()->WaitForAsyncFrameDecode();
+	uint32_t count = frame.Width * frame.Height;
+	assert(count <= GbConstants::LinkedPixelCount);
+	if(owner->_completedPixelCount == count) {
+		std::copy(owner->_completedFrame, owner->_completedFrame + count, owner->_previousCompletedFrame);
+	} else {
+		std::fill(std::begin(owner->_previousCompletedFrame), std::end(owner->_previousCompletedFrame), 0);
+	}
+	std::copy(static_cast<uint16_t*>(frame.FrameBuffer), static_cast<uint16_t*>(frame.FrameBuffer) + count, owner->_completedFrame);
+	owner->_completedPixelCount = count;
+	frame.Data = owner->_previousCompletedFrame;
+	_emu->GetVideoDecoder()->UpdateFrame(frame, synchronous, rewinding);
 }
 
