+
+bool Gameboy::ValidateRasterState(Serializer& s)
+{
+	s.PushNamePrefix("_ppu", -1);
+	bool valid = GbPpu::ValidateRasterState(s);
+	s.PopNamePrefix();
+	if(valid && _secondaryConsole) {
+		s.PushNamePrefix("_secondaryConsole", -1);
+		valid = _secondaryConsole->ValidateRasterState(s);
+		s.PopNamePrefix();
+	}
+	return valid;
+}
+
 void Gameboy::Serialize(Serializer& s)
 {
+	if(!s.IsSaving() && s.GetFormat() != SerializeFormat::Map) {
+		if(!ValidateRasterState(s)) {
+			s.SetErrorFlag();
+			return;
+		}
+		_emu->GetVideoDecoder()->WaitForAsyncFrameDecode();
+	}
 	SV(_cpu);
 	SV(_ppu);
 	SV(_apu);
