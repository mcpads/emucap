+bool GbPpu::ValidateRasterState(Serializer& s)
+{
+	uint32_t version = 0, count = 0;
+	uint8_t index = 0xff;
+	return s.TryReadValue("rasterVersion", version) && version == 1
+		&& s.TryReadValue("outputBufferIndex", index) && index < 2
+		&& s.TryReadValue("completedPixelCount", count)
+		&& (count == 0 || count == GbConstants::PixelCount || count == GbConstants::LinkedPixelCount)
+		&& s.HasValueSize("outputBuffer0", GbConstants::PixelCount * sizeof(uint16_t))
+		&& s.HasValueSize("outputBuffer1", GbConstants::PixelCount * sizeof(uint16_t))
+		&& s.HasValueSize("completedFrame", GbConstants::LinkedPixelCount * sizeof(uint16_t))
+		&& s.HasValueSize("previousCompletedFrame", GbConstants::LinkedPixelCount * sizeof(uint16_t));
 }
 
