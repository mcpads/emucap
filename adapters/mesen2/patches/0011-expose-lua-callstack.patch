+int LuaApi::GetCallstack(lua_State* lua)
+{
+	LuaCallHelper l(lua);
+	l.ForceParamCount(1);
+	CpuType cpuType = (CpuType)l.ReadInteger((uint32_t)_context->GetDefaultCpuType());
+	checkEnum(CpuType, cpuType, "invalid cpu type");
+
+	StackFrameInfo frames[512] = {};
+	uint32_t frameCount = 0;
+	CallstackManager* manager = _debugger->GetCallstackManager(cpuType);
+	if(manager) {
+		manager->GetCallstack(frames, frameCount);
+	}
+
+	lua_createtable(lua, frameCount, 0);
+	for(uint32_t i = 0; i < frameCount; i++) {
+		StackFrameInfo& frame = frames[i];
+		lua_createtable(lua, 0, 11);
+		lua_pushintvalue(source, frame.Source);
+		lua_pushintvalue(target, frame.Target);
+		lua_pushintvalue(returnAddress, frame.Return);
+		lua_pushintvalue(returnStackPointer, frame.ReturnStackPointer);
+		lua_pushintvalue(flags, frame.Flags);
+		lua_pushintvalue(absoluteSource, frame.AbsSource.Address);
+		lua_pushintvalue(sourceMemoryType, frame.AbsSource.Type);
+		lua_pushintvalue(absoluteTarget, frame.AbsTarget.Address);
+		lua_pushintvalue(targetMemoryType, frame.AbsTarget.Type);
+		lua_pushintvalue(absoluteReturn, frame.AbsReturn.Address);
+		lua_pushintvalue(returnMemoryType, frame.AbsReturn.Type);
+		lua_rawseti(lua, -2, i + 1);
+	}
+	return 1;
+}
