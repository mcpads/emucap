+		&& s.TryReadValue("outputBufferIndex", index) && index < 2
+		&& s.HasValueSize("outputBuffer0", 256 * 240 * sizeof(uint16_t))
+		&& s.HasValueSize("outputBuffer1", 256 * 240 * sizeof(uint16_t));
