+uint16_t SnesPpu::ReadBgChrWord(uint16_t address, uint8_t layer)
+{
+	uint16_t value = _vram[address];
+	if(_bgChrFetchDebugger) {
+		RecordBgChrFetch(address, value, layer);
+	}
+	return value;
+}
+
+void SnesPpu::RecordBgChrFetch(uint16_t address, uint16_t value, uint8_t layer)
+{
+	SnesObservationEvent event;
+	event.Frame = _emu->GetFrameCount();
+	event.MasterClock = _memoryManager->GetMasterClock();
+	event.Address = address;
+	event.VramValue = value;
+	event.Layer = layer;
+	event.Scanline = _state.Scanline;
+	event.Dot = _state.Cycle;
+	event.HClock = _state.HClock;
+	_bgChrFetchDebugger->ProcessSnesObservationEvent(EventType::SnesPpuBgChrFetch, event);
+}
