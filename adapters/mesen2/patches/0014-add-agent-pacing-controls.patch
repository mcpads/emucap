+static void PushPacing(lua_State* lua, Emulator* emu)
+{
+	EmuSettings* settings = emu->GetSettings();
+	EmulationConfig& cfg = settings->GetEmulationConfig();
+	lua_newtable(lua);
+	lua_pushintvalue(emulationSpeed, cfg.EmulationSpeed);
+	lua_pushintvalue(turboSpeed, cfg.TurboSpeed);
+	lua_pushintvalue(rewindSpeed, cfg.RewindSpeed);
+	lua_pushintvalue(effectiveSpeed, settings->GetEmulationSpeed());
+	lua_pushboolvalue(maximumSpeed, settings->CheckFlag(EmulationFlags::MaximumSpeed));
+	lua_pushboolvalue(turbo, settings->CheckFlag(EmulationFlags::Turbo));
+	lua_pushboolvalue(rewind, settings->CheckFlag(EmulationFlags::Rewind));
+}
+
+int LuaApi::GetPacing(lua_State* lua)
+{
+	LuaCallHelper l(lua);
+	checkparams();
+	PushPacing(lua, _emu);
+	return 1;
+}
+
+int LuaApi::SetPacing(lua_State* lua)
+{
+	//Sets the base speed in percent (0 = unlimited) and the maximum-speed override (cleared unless
+	//requested) in one emulation-thread call, then returns the observed policy. Held turbo/rewind
+	//keys still override.
+	LuaCallHelper l(lua);
+	l.ForceParamCount(2);
+	bool maximumSpeed = l.ReadBool(false);
+	uint32_t speed = l.ReadInteger();
+	checkminparams(1);
+	EmuSettings* settings = _emu->GetSettings();
+	settings->GetEmulationConfig().EmulationSpeed = speed;
+	settings->SetFlagState(EmulationFlags::MaximumSpeed, maximumSpeed);
+	PushPacing(lua, _emu);
+	return 1;
+}
+
+int LuaApi::EndPacingWait(lua_State* lua)
+{
+	LuaCallHelper l(lua);
+	checkparams();
+	_emu->RequestPacingWake();
+	return l.ReturnCount();
+}
