+uint16_t SnesPpu::ReadCgramForRenderer(uint16_t address, uint8_t layer, uint16_t pixelX)
+{
+	uint16_t value = _cgram[address];
+	if(_cgramLookupDebugger) {
+		RecordCgramLookup(address, value, layer, pixelX);
+	}
+	return value;
