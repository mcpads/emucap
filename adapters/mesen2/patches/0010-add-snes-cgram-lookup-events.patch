+
+void SnesPpu::RecordCgramLookup(uint16_t address, uint16_t value, uint8_t layer, uint16_t pixelX)
+{
+	SnesObservationEvent event;
+	event.Frame = _emu->GetFrameCount();
+	event.MasterClock = _memoryManager->GetMasterClock();
+	event.Address = address;
+	event.CgramValue = value;
+	event.Layer = layer;
+	event.PixelX = pixelX;
+	event.Scanline = _state.Scanline;
+	event.Dot = _state.Cycle;
+	event.HClock = _state.HClock;
+	_cgramLookupDebugger->ProcessSnesObservationEvent(EventType::SnesPpuCgramLookup, event);
+}
