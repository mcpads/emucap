+bool NesConsole::ValidateRasterState(Serializer& s)
+{
+	s.PushNamePrefix("_ppu", -1);
+	bool valid = _ppu->ValidateRasterState(s);
+	s.PopNamePrefix();
+	if(valid && _vsSubConsole) {
+		s.PushNamePrefix("_vsSubConsole", -1);
+		valid = _vsSubConsole->ValidateRasterState(s);
+		s.PopNamePrefix();
+	}
+	return valid;
+}
+
 void NesConsole::Serialize(Serializer& s)
 {
+	if(!s.IsSaving() && s.GetFormat() != SerializeFormat::Map) {
+		if(!ValidateRasterState(s)) {
+			s.SetErrorFlag();
+			return;
+		}
+		_emu->GetVideoDecoder()->WaitForAsyncFrameDecode();
+	}
 	SV(_cpu);
 	SV(_ppu);
 	SV(_memoryManager);
